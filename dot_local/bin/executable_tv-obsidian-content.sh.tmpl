#!/usr/bin/env bash
RG=/home/linuxbrew/.linuxbrew/bin/rg
VAULT_DIR="{{ .obsidian.vault_path }}"
VAULT_NAME="{{ .obsidian.vault_name }}"

echo -n "Search content: "
read -r query
[ -z "$query" ] && exit 0

output=$(
    $RG -l -S --glob "*.md" "$query" "$VAULT_DIR" |
    awk -v vault_dir="$VAULT_DIR/" '{
      path = $0;
      sub(vault_dir, "", path); # Remove absolute path prefix
      
      match(path, /.*\//);
      if (RLENGTH > 0) {
        dir = substr(path, 1, RLENGTH);
        file = substr(path, RLENGTH+1);
        
        first_slash = index(dir, "/");
        parent = substr(dir, 1, first_slash);
        rest_dir = substr(dir, first_slash + 1);
        
        printf "\033[38;2;208;167;175m%s\033[36m%s\033[0m%s\n", parent, rest_dir, file;
      } else {
        printf "\033[0m%s\n", path;
      }
    }' |
    tv --ansi \
       --source-output="{strip_ansi}" \
       --preview-command="$RG --color=always -C2 '$query' \"$VAULT_DIR/{strip_ansi}\"" \
       --preview-size=60 \
       --preview-word-wrap \
       --preview-border=thick \
       --input-header="Results: $query" \
       --layout=portrait \
       --expect="ctrl-p;ctrl-c;ctrl-y"
)

[ -z "$output" ] && exit 0

first_line=$(echo "$output" | head -n 1)
if [[ "$first_line" == "ctrl-p" || "$first_line" == "ctrl-c" || "$first_line" == "ctrl-y" ]]; then
    key="$first_line"
    selected=$(echo "$output" | tail -n +2)
else
    key="enter"
    selected="$output"
fi

[ -z "$selected" ] && exit 0

if [ "$key" = "ctrl-p" ]; then
    printf "%s\n" "$selected" | sed "s|^|$VAULT_DIR/|" | wl-copy
    exit 0
elif [ "$key" = "ctrl-c" ]; then
    printf "%s\n" "$selected" | wl-copy
    exit 0
elif [ "$key" = "ctrl-y" ]; then
    paths=$(printf "%s\n" "$selected" | tr '\n' ' ')
    printf "read %s\n" "$paths" | wl-copy
    exit 0
fi

mapfile -t items <<< "$selected"
"{{ .chezmoi.homeDir }}/.local/bin/tv-action-obsidian.sh" "${items[@]}"
