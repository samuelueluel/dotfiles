#!/usr/bin/env python3
"""
CLI helper to query and switch Antigravity CLI's tool permissions / execution policy.
Directly updates ~/.gemini/antigravity-cli/settings.json.
"""
import sys
import json
from pathlib import Path

SETTINGS_FILE = Path.home() / ".gemini" / "antigravity-cli" / "settings.json"

POLICIES = {
    "always-proceed": "always-proceed",
    "auto": "always-proceed",
    "yolo": "always-proceed",
    "request-review": "request-review",
    "manual": "request-review",
    "review": "request-review",
    "strict": "strict",
}

SAFE_ALLOW_LIST = [
    "command(rg *)",
    "command(rg)",
    "command(fd *)",
    "command(fd)",
    "command(grep *)",
    "command(grep)",
    "command(ag *)",
