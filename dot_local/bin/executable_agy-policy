    "command(rev *)",
    "command(find *)",
    "command(find)",
    "command(stat *)",
    "command(stat)",
    "command(file *)",
    "command(file)",
    "command(du *)",
    "command(du)",
    "command(df *)",
    "command(df)",
    "command(pwd)",
    "command(which *)",
    "command(which)",
    "command(type *)",
    "command(type)",
    "command(sort *)",
    "command(sort)",
    "command(uniq *)",
    "command(uniq)",
    "command(wc *)",
    "command(wc)",
