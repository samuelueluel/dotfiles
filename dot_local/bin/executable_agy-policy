    "command(readelf *)",
    "command(bc *)",
    "command(time *)",
    "command(man *)",
    "command(info *)",
    "command(apropos *)",
    "command(whatis *)",
    "command(echo *)",
    "command(echo)",
    "command(true)",
    "command(false)",
    "command(whoami)",
    "command(id)",
    "command(uptime)",
    "command(free *)",
    "command(free)",
    "command(ps *)",
    "command(ps)",
    "command(cal *)",
    "command(cal)",
    "command(lsof *)",
    "command(ss *)",
    "command(netstat *)",
    "command(lspci *)",
    "command(lsusb *)",
    "command(lscpu *)",
    "command(dmidecode *)",
    "command(lsblk *)",
    "command(env)",
    "command(printenv *)",
    "command(printenv)",
    "command(chezmoi status*)",
    "command(chezmoi diff*)",
    "command(niri *)",
    "command(niri)"
]

STANDARD_DENY_LIST = [
    "command(rm -rf /)",
    "command(rm -rf /*)",
    "command(sudo *)",
    "command(sudo)"
]


def load_settings() -> dict:
    if not SETTINGS_FILE.exists():
        return {}
    try:
        with open(SETTINGS_FILE, "r") as f:
            return json.load(f)
    except Exception as e:
        print(f"Error reading settings: {e}", file=sys.stderr)
        return {}


def save_settings(settings: dict):
    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(SETTINGS_FILE, "w") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")


def get_policy() -> str:
    settings = load_settings()
    perms = settings.get("permissions", {})
    allow = perms.get("allow", [])

    if "command(*)" in allow:
        canonical = "always-proceed"
    elif not allow:
        canonical = "strict"
    else:
        canonical = "request-review"

    descriptions = {
        "always-proceed": "always-proceed (auto / yolo — full autonomy: all commands and tools execute without prompts)",
        "request-review": "request-review (manual — safe read-only commands auto-run, mutating commands prompt)",
        "strict": "strict (all commands prompt for review)",
    }
    print(f"Active Tool Execution Policy: {descriptions[canonical]}")
    return canonical


def set_policy(target: str):
    key = target.lower().strip()
    if key not in POLICIES:
        print(
            f"Invalid policy: '{target}'. Valid options: always-proceed (auto), request-review (manual), strict",
            file=sys.stderr,
        )
        sys.exit(1)

    canonical = POLICIES[key]
    settings = load_settings()

    perms = settings.setdefault("permissions", {})
    perms.setdefault("deny", STANDARD_DENY_LIST)
    perms.setdefault("ask", [])

    if canonical == "always-proceed":
        perms["allow"] = ["command(*)", "mcp(*)"]
    elif canonical == "request-review":
        perms["allow"] = list(SAFE_ALLOW_LIST)
    elif canonical == "strict":
        perms["allow"] = []

    settings["toolExecutionPolicy"] = canonical
    save_settings(settings)

    descriptions = {
        "always-proceed": "always-proceed (auto — full autonomy: all commands and tools execute without prompts)",
        "request-review": "request-review (manual — safe read-only commands auto-run, mutating commands prompt)",
        "strict": "strict (all actions prompt)",
    }
    print(f"Tool Execution Policy set to: {descriptions[canonical]}")


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in {"status", "get", "show"}:
        get_policy()
    else:
        set_policy(sys.argv[1])
