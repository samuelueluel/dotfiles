#!/usr/bin/env python3
"""
Toggles between scroller mode and tile-scroll mode in Niri.

Tile-scroll mode:
  - All columns on all workspaces set to 50% width
  - center-focused-column never + gaps 2 + focus-ring width 0
  - default-column-width 50%
  - All windows set to opacity 1.0
  - Ghostty opacity 1.0 + black wallpaper

Exit restores the full snapshot taken at entry.
Uses separate config-tile.kdl so config.kdl is NEVER modified in place.
Uses file locking to prevent race conditions from rapid successive keypresses.
Uses wallpaper and column width guards so backups can never be corrupted.
"""

import fcntl
import json
import os
import re
import shutil
import socket
import subprocess
import sys

CONFIG = os.path.expanduser("~/.config/niri/config.kdl")
TILE_CONFIG = os.path.expanduser("~/.config/niri/config-tile.kdl")
GHOSTTY_CONFIG = os.path.expanduser("~/.config/ghostty/config.ghostty")
WALLPAPER_BACKUP = os.path.expanduser("~/.cache/niri-tile-toggle-wallpaper")
DEFAULT_WALLPAPER = os.path.expanduser("~/Pictures/Wallpapers/pedernal-NM.jpg")
TILE_WALLPAPER = os.path.expanduser("~/Pictures/Wallpapers/black.png")
STATE_FILE = os.path.expanduser("~/.cache/niri-tile-toggle")
LOCK_FILE = os.path.expanduser("~/.cache/niri-tile-toggle.lock")
COLUMNS_FILE = os.path.expanduser("~/.cache/niri-tile-toggle-columns")
COLUMNS_DEBUG = os.path.expanduser("~/.cache/niri-tile-toggle-columns-debug")

FREEZE_MS = 200


class NiriClient:
    def __init__(self):
        sock_path = os.environ.get("NIRI_SOCKET")
        if not sock_path:
            raise RuntimeError("NIRI_SOCKET environment variable not set")
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.connect(sock_path)
        self.buf = b""

    def request(self, req_obj):
        line = json.dumps(req_obj) + "\n"
        self.s.sendall(line.encode("utf-8"))
        while b"\n" not in self.buf:
            chunk = self.s.recv(4096)
            if not chunk:
                break
            self.buf += chunk
        idx = self.buf.index(b"\n")
        line = self.buf[:idx]
        self.buf = self.buf[idx + 1 :]
        return json.loads(line.decode("utf-8"))

    def action(self, action_name, **kwargs):
        return self.request({"Action": {action_name: kwargs}})

    def close(self):
        self.s.close()


def ensure_tile_config():
    """Generate config-tile.kdl from config.kdl with tile overrides."""
    with open(CONFIG) as f:
        cfg = f.read()

    cfg = re.sub(r'center-focused-column "[^"]*"', 'center-focused-column "never"', cfg)
    cfg = re.sub(r"(?m)^(\s*)gaps \d+", r"\g<1>gaps 2", cfg)
    cfg = re.sub(
        r"width \d+ // \*\*don't remove this comment, it's needed by niri-tile-toggle\*\*",
        r"width 2 // **don't remove this comment, it's needed by niri-tile-toggle**",
        cfg,
    )
    cfg = re.sub(
        r"default-column-width\s*\{\s*proportion\s*0\.[0-9]+;\s*\}",
        "default-column-width { proportion 0.5; }",
        cfg,
    )
    cfg = re.sub(r"opacity 0\.[0-9]+", "opacity 1.0", cfg)

    tmp = TILE_CONFIG + ".tmp"
    with open(tmp, "w") as f:
        f.write(cfg)
    os.replace(tmp, TILE_CONFIG)


def get_default_proportion():
    try:
        with open(CONFIG) as f:
            m = re.search(r"default-column-width\s*\{\s*proportion\s*(0\.[0-9]+);\s*\}", f.read())
            if m:
                return float(m.group(1)) * 100.0
    except Exception:
        pass
    return 76.666667


def get_column_widths(client, config_path):
    win_data = client.request("Windows").get("Ok", {}).get("Windows", [])
    ws_data = client.request("Workspaces").get("Ok", {}).get("Workspaces", [])
    out_data = client.request("Outputs").get("Ok", {}).get("Outputs", {})

    gaps = 4
    try:
        with open(config_path) as f:
            m = re.search(r"(?m)^\s+gaps (\d+)", f.read())
            if m:
                gaps = int(m.group(1))
    except Exception:
        pass
    correction = gaps - 1

    ws_to_output = {ws["id"]: ws.get("output") for ws in ws_data}
    output_widths = {}
    for name, out in out_data.items():
        logical = out.get("logical") or {}
        w = logical.get("width")
        if w:
            output_widths[name] = w

    col_widths = {}
    for w in win_data:
        ws_id = w.get("workspace_id")
        if ws_id is None:
            continue
        layout = w.get("layout") or {}
        pos = layout.get("pos_in_scrolling_layout")
        if pos is None:
            continue
        window_size = layout.get("window_size")
        tile_size = layout.get("tile_size")
        if window_size is None:
            continue
        key = f"({ws_id}, {pos[0]})"
        if key in col_widths:
            continue

        out_w = output_widths.get(ws_to_output.get(ws_id))
        is_full = False
        if out_w and tile_size:
            if tile_size[0] >= (out_w - 2 * gaps - 2):
                is_full = True
        if is_full:
            col_widths[key] = "100%"
        else:
            col_widths[key] = window_size[0] - correction

    return col_widths, output_widths, ws_to_output


def resize_all_columns(client, proportion=50.0):
    win_data = client.request("Windows").get("Ok", {}).get("Windows", [])
    focused_win_id = next((w["id"] for w in win_data if w.get("is_focused")), None)

    cols = {}
    for w in win_data:
        ws_id = w.get("workspace_id")
        if ws_id is None:
            continue
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        if pos is None:
            continue
        key = f"({ws_id}, {pos[0]})"
        if key not in cols:
            cols[key] = (ws_id, pos[0], w["id"])

    focused_ws_id = None
    if focused_win_id:
        f_win = next((w for w in win_data if w["id"] == focused_win_id), None)
        if f_win:
            focused_ws_id = f_win.get("workspace_id")

    sorted_cols = sorted(
        cols.items(),
        key=lambda item: (1 if item[1][0] == focused_ws_id else 0, item[1][0], item[1][1]),
    )

    for key, (ws_id, col_idx, win_id) in sorted_cols:
        client.action("FocusWindow", id=win_id)
        client.action("SetColumnWidth", change={"SetProportion": proportion})

    if focused_win_id:
        client.action("FocusWindow", id=focused_win_id)


def restore_column_widths(client, col_widths, output_widths, ws_to_output, default_prop=76.666667):
    win_data = client.request("Windows").get("Ok", {}).get("Windows", [])
    focused_win_id = next((w["id"] for w in win_data if w.get("is_focused")), None)

    cols = {}
    for w in win_data:
        ws_id = w.get("workspace_id")
        if ws_id is None:
            continue
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        if pos is None:
            continue
        key = f"({ws_id}, {pos[0]})"
        if key not in cols:
            cols[key] = (ws_id, pos[0], w["id"])

    focused_ws_id = None
    if focused_win_id:
        f_win = next((w for w in win_data if w["id"] == focused_win_id), None)
        if f_win:
            focused_ws_id = f_win.get("workspace_id")

    sorted_cols = sorted(
        cols.items(),
        key=lambda item: (1 if item[1][0] == focused_ws_id else 0, item[1][0], item[1][1]),
    )

    for key, (ws_id, col_idx, win_id) in sorted_cols:
        width = col_widths.get(key)
        out_w = output_widths.get(ws_to_output.get(ws_id), 1536)

        is_50 = False
        if isinstance(width, (int, float)) and out_w:
            if 0.45 <= (width / out_w) <= 0.55:
                is_50 = True

        client.action("FocusWindow", id=win_id)
        if width == "100%":
            client.action("SetColumnWidth", change={"SetProportion": 100.0})
        elif width is None or width == "default" or is_50:
            client.action("SetColumnWidth", change={"SetProportion": default_prop})
        else:
            try:
                val = int(width)
                client.action("SetColumnWidth", change={"SetFixed": val})
            except ValueError:
                client.action("SetColumnWidth", change={"SetProportion": default_prop})

    if focused_win_id:
        client.action("FocusWindow", id=focused_win_id)


def enter_tile_mode(client):
    # 1. Freeze screen immediately
    client.action("DoScreenTransition", delay_ms=FREEZE_MS)

    # 2. Save current column widths (never overwrite good non-50% sizes with 50% values)
    saved_widths = {}
    if os.path.exists(COLUMNS_FILE):
        try:
            with open(COLUMNS_FILE) as f:
                saved_widths = json.load(f)
        except Exception:
            pass

    cur_widths, output_widths, ws_to_output = get_column_widths(client, CONFIG)
    col_widths = dict(saved_widths)

    for key, w in cur_widths.items():
        ws_id = int(key.strip("()").split(",")[0])
        out_w = output_widths.get(ws_to_output.get(ws_id), 1536)
        is_50 = False
        if isinstance(w, (int, float)) and out_w:
            if 0.45 <= (w / out_w) <= 0.55:
                is_50 = True

        if not is_50:
            col_widths[key] = w
        elif key not in col_widths:
            col_widths[key] = "default"

    with open(COLUMNS_FILE, "w") as f:
        json.dump(col_widths, f)
    shutil.copyfile(COLUMNS_FILE, COLUMNS_DEBUG)

    # 3. Snapshot wallpaper (guarded: never save black as the backup wallpaper)
    try:
        cur_wp = subprocess.check_output(["noctalia", "msg", "wallpaper-get"], text=True).strip()
        if cur_wp and cur_wp != TILE_WALLPAPER:
            with open(WALLPAPER_BACKUP, "w") as f:
                f.write(cur_wp)
        subprocess.run(["noctalia", "msg", "wallpaper-set", TILE_WALLPAPER], capture_output=True)
    except Exception:
        pass

    # 4. Ghostty opacity to 1.0
    if os.path.exists(GHOSTTY_CONFIG):
        try:
            with open(GHOSTTY_CONFIG) as f:
                g_text = f.read()
            g_mod = re.sub(r"^background-opacity = .*", "background-opacity = 1", g_text, flags=re.M)
            with open(GHOSTTY_CONFIG, "w") as f:
                f.write(g_mod)
            subprocess.run(["pkill", "-SIGUSR2", "ghostty"], capture_output=True)
        except Exception:
            pass

    # 5. Load tile configuration (leaves config.kdl completely untouched!)
    ensure_tile_config()
    client.action("LoadConfigFile", path=TILE_CONFIG)

    # 6. Resize all columns across all workspaces to 50%
    resize_all_columns(client, 50.0)

    # 7. Mark tile mode active
    with open(STATE_FILE, "w") as f:
        f.write("tile\n")


def exit_tile_mode(client):
    # 1. Freeze screen immediately
    client.action("DoScreenTransition", delay_ms=FREEZE_MS)

    # 2. Restore normal config (leaves config.kdl completely untouched!)
    client.action("LoadConfigFile", path=CONFIG)

    # 3. Restore wallpaper (fallback to default if corrupted/black)
    wp_to_restore = DEFAULT_WALLPAPER
    if os.path.exists(WALLPAPER_BACKUP):
        try:
            with open(WALLPAPER_BACKUP) as f:
                saved = f.read().strip()
            if saved and saved != TILE_WALLPAPER and os.path.exists(saved):
                wp_to_restore = saved
        except Exception:
            pass
    try:
        subprocess.run(["noctalia", "msg", "wallpaper-set", wp_to_restore], capture_output=True)
    except Exception:
        pass

    # 4. Restore Ghostty opacity to 0.9
    if os.path.exists(GHOSTTY_CONFIG):
        try:
            with open(GHOSTTY_CONFIG) as f:
                g_text = f.read()
            g_mod = re.sub(r"^background-opacity = .*", "background-opacity = 0.9", g_text, flags=re.M)
            with open(GHOSTTY_CONFIG, "w") as f:
                f.write(g_mod)
            subprocess.run(["pkill", "-SIGUSR2", "ghostty"], capture_output=True)
        except Exception:
            pass

    # 5. Restore column widths
    default_prop = get_default_proportion()
    col_widths = {}
    if os.path.exists(COLUMNS_FILE):
        try:
            with open(COLUMNS_FILE) as f:
                col_widths = json.load(f)
        except Exception:
            pass

    _, output_widths, ws_to_output = get_column_widths(client, CONFIG)
    restore_column_widths(client, col_widths, output_widths, ws_to_output, default_prop)

    # 6. Clean up state file (keep COLUMNS_FILE and WALLPAPER_BACKUP for persistence)
    try:
        if os.path.exists(STATE_FILE):
            os.remove(STATE_FILE)
    except OSError:
        pass


def main():
    # Lock to prevent race conditions if Mod+I is pressed rapidly in succession
    os.makedirs(os.path.expanduser("~/.cache"), exist_ok=True)
    lock_fd = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        # Already running another toggle instance; drop to prevent corruption
        sys.exit(0)

    try:
        client = NiriClient()
    except Exception as e:
        print(f"Error connecting to niri socket: {e}", file=sys.stderr)
        sys.exit(1)

    if os.path.exists(STATE_FILE):
        exit_tile_mode(client)
    else:
        enter_tile_mode(client)

    client.close()


if __name__ == "__main__":
    main()
