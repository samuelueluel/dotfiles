#!/usr/bin/env python3
"""
strix-llm-bench — reproducible Strix-Llama speed benchmark following LLM-Bench protocol.

Measures server-side throughput directly against the running strix-llama container:
* Target prompt prefill: ~2048 new tokens (PP2048)
* Target generation: exactly 182 tokens (TG182; EOS is ignored)
* Context depths: d0, d30000, d60000, d150000
* Workloads: Stata code (or prose)
* Reasoning: disabled via chat_template_kwargs={"enable_thinking": False}
* Speculation: MTP timings recorded from server response
* Cache control: unique nonce per cell; deep target cache hits strictly required
* Power sampling: amdgpu PPT average at 1.0s interval
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import math
import os
import re
import socket
import statistics
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path
from typing import Any, Callable

SCRIPT_NAME = "strix-llm-bench"
SCRIPT_VERSION = "1.0"
DEFAULT_BASE_URL = "http://127.0.0.1:8732"
DEFAULT_OUTDIR = Path.home() / ".local/share/ramalama/benchmarks"
PP_TARGET = 2048
TG_TARGET = 182
DEFAULT_DEPTHS = [0, 30000, 60000, 150000]
DEFAULT_RUNS = 2
PROMPT_VERSION = "builtin-2"

TASK_LABELS = {
    "prose": "prose synthesis",
    "stata": "Stata code",
}
TASK_ORDER = ("prose", "stata")

