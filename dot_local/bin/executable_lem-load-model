#!/usr/bin/env bash
# Load one local Lemonade model using the same interactive settings used by
# the normal pi/beta wrappers. The provider/model target is configured by the
# caller; this command only handles Lemonade's resident local model.
set -euo pipefail

LEM_API=${LEM_API:-http://127.0.0.1:13305/api/v1}
QWEN_SAMPLING="--temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0"
QWEN38_SAMPLING="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0"
QWEN38_FLASH_SAMPLING="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0 --repeat-penalty 1.0"
DS4FLASH_SAMPLING="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0"
QWEN38_DFLASH2_DRAFT="/root/.cache/huggingface/hub/models--incoai--Qwen3.8-27B-DFlash2-GGUF/snapshots/main/Qwen3.8-27B-DFlash2-Q4_K_M.gguf"
QWEN38_FLASH_MTP="/root/.cache/huggingface/qwen3.8-flash-next/Qwen3.8-Flash-Next-MTP-Q8_0.gguf"
QWEN38_FLASH_FP4_MTP="/root/.cache/huggingface/qwen3.8-flash-next/Qwen3.8-Flash-Next-MTP-ROCmFP4-FAST.gguf"
QWEN38_FLASH_FP4_MTP_URL="https://huggingface.co/agentionai/Qwen3.8-Flash-Next-MTP-ROCmFP4-FAST-GGUF/resolve/main/Qwen3.8-Flash-Next-MTP-ROCmFP4-FAST.gguf?download=true"
QWEN38_FLASH_FP4_MTP_SIZE=2444519296

usage() {
  cat <<'EOF'
Usage:
  lem-load-model MODEL_ID

Load a local Lemonade model and choose speculative decoding, reasoning,
KV-cache quantization, and parallel slots using gum.
EOF
}

die() {
  printf 'lem-load-model: %s\n' "$*" >&2
  exit 1
}

ensure_qwen38_flash_fp4_mtp() {
  local cache_root target part size
  cache_root=$(podman volume inspect --format '{{.Mountpoint}}' lemonade-cache 2>/dev/null || true)
  [[ -n "$cache_root" ]] || cache_root="$HOME/.local/share/containers/storage/volumes/lemonade-cache/_data"
  target="$cache_root/qwen3.8-flash-next/$(basename "$QWEN38_FLASH_FP4_MTP")"
  part="$target.part"

  size=$(stat -c '%s' "$target" 2>/dev/null || echo 0)
  [[ "$size" == "$QWEN38_FLASH_FP4_MTP_SIZE" ]] && return 0

  mkdir -p "$(dirname "$target")"
  if [[ -f "$target" && ! -f "$part" ]]; then
    mv -f "$target" "$part"
  fi

  gum spin --show-output --title "downloading ROCmFP4 MTP sidecar (2.28 GiB)" -- \
    curl -fL --retry 5 --retry-delay 3 --retry-connrefused --continue-at - \
      -o "$part" "$QWEN38_FLASH_FP4_MTP_URL" \
    || die "ROCmFP4 MTP sidecar download failed"

  size=$(stat -c '%s' "$part" 2>/dev/null || echo 0)
  [[ "$size" == "$QWEN38_FLASH_FP4_MTP_SIZE" ]] \
    || die "ROCmFP4 MTP sidecar has size $size; expected $QWEN38_FLASH_FP4_MTP_SIZE"
  mv -f "$part" "$target"
}

[[ -n "${1:-}" ]] || { usage >&2; exit 2; }
selection=$1
[[ "$selection" != *$'\n'* && "$selection" != *$'\r'* && "$selection" != *' '* ]] || die "model contains whitespace"

# Backend-qualified Flash choices are launcher aliases, not Lemonade model IDs.
# Keep the canonical ID for registry lookup and the OpenAI model name.
id="$selection"
fixed_halo_backend=""
case "$selection" in
  UD-Q4_K_XL@halo-vulkan)
    id="UD-Q4_K_XL"
    fixed_halo_backend="halo-vulkan"
    ;;
  UD-Q4_K_XL@halo-rocm)
    id="UD-Q4_K_XL"
    fixed_halo_backend="halo-rocm"
    ;;
  *@*)
    die "unsupported model/backend selection: $selection"
    ;;
esac

command -v gum >/dev/null 2>&1 || die "gum is required for local model loading"

curl -sS -m 5 "$LEM_API/health" >/dev/null 2>&1 \
  || die "Lemonade not reachable on $LEM_API (container up? try 'podman start lemonade')"

args=""
pi_thinking_level="unknown"
fixed_parallel=0
if [[ -n "$fixed_halo_backend" ]]; then
  if [[ -n "${LEM_HALO_BACKEND:-}" && "${LEM_HALO_BACKEND}" != "$fixed_halo_backend" ]]; then
    die "$selection conflicts with LEM_HALO_BACKEND=${LEM_HALO_BACKEND}"
  fi
  halo_backend="$fixed_halo_backend"
else
  halo_backend="${LEM_HALO_BACKEND:-}"
fi
case "$id" in
  Qwen3.8-Flash-Next-ROCmFP4*)
    # Agention's per-head ROCmFP4-FAST imatrix GGUF. This is not the
    # Nathan Q4_K_XL file: Laurent's qwen4exp-rocmfpx Vulkan engine is required.
    fixed_parallel=1
    pi_thinking_level="max"
    args+=" --force-laurent --fit off -b 2048 -ub 512 -ngl 99 -fa on --reasoning on"

    mtp=$(gum choose --header "speculative decoding" --selected "on  MTP" \
      "on  MTP" \
      "off  Base") || exit 1
    case "${mtp%%[ ]*}" in
      on)
        ensure_qwen38_flash_fp4_mtp
        args+=" --spec-type draft-mtp --spec-draft-model $QWEN38_FLASH_FP4_MTP --spec-draft-adaptive --spec-draft-n-min 2 --spec-draft-n-max 4 --n-gpu-layers-draft 99 -ctkd q8_0 -ctvd q8_0"
        ;;
      off)
        args+=" --spec-type none"
        ;;
    esac

    args+=" $QWEN38_FLASH_SAMPLING"
    effort=$(gum choose --header "thinking / reasoning effort" \
      "xhigh  Xhigh" \
      "medium Medium" \
      "low    Low" \
      "off    Off") || exit 1
    case "${effort%%[ ]*}" in
      xhigh)
        pi_thinking_level="max"
        args+=" --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22.jinja"
        ;;
      medium)
        pi_thinking_level="medium"
        args+=" --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-medium.jinja"
        ;;
      low)
        pi_thinking_level="low"
        args+=" --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-low.jinja"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-off.jinja"
        ;;
    esac

    kv=$(gum choose --header "KV cache quantization" --selected "q8   Q8_0" \
      "q8   Q8_0" \
      "f16  F16") || exit 1
    case "${kv%%[ ]*}" in
      q8) args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
    ;;
  UD-Q4_K_XL|UD-IQ4_XS|Qwen3.8-Flash-Next-*)
    # Qwen3.8-Flash-Next is a qwen4exp model with a very large PLE tensor.
    # The extra-model registry attaches mmproj-F16.gguf; preserve mmap-backed
    # loading while selecting the requested runtime backend.
    fixed_parallel=1
    pi_thinking_level="max"
    if [[ "$fixed_halo_backend" == "halo-vulkan" ]]; then
      args+=" --force-halo-vulkan --load-mode mmap --no-host --no-repack --fit off -b 2048 -ub 2048 -ngl 99 --n-cpu-moe 0 -fa on --reasoning on"
    elif [[ "$fixed_halo_backend" == "halo-rocm" ]]; then
      args+=" --force-halo-rocm --load-mode mmap --no-host --no-repack --fit off -b 2048 -ub 2048 -ngl 99 --n-cpu-moe 0 -fa on --reasoning on"
    else
      args+=" --force-vulkan --load-mode mmap --tensor-read-lazy auto --no-host --no-repack --fit off -b 2048 -ub 2048 -ngl 99 --n-cpu-moe 0 -fa on --reasoning on"
    fi

    mtp=$(gum choose --header "speculative decoding" --selected "on  MTP" \
      "on  MTP" \
      "off  Base") || exit 1
    case "${mtp%%[ ]*}" in
      on)
        args+=" --spec-type draft-mtp --spec-draft-model $QWEN38_FLASH_MTP --spec-draft-n-max 3 --spec-draft-p-min 0.75"
        ;;
      off)
        args+=" --spec-type none"
        ;;
    esac

    effort=$(gum choose --header "thinking / reasoning effort" \
      "xhigh  Xhigh" \
      "medium Medium" \
      "low    Low" \
      "off    Off") || exit 1
    case "${effort%%[ ]*}" in
      xhigh)
        pi_thinking_level="max"
        args+=" $QWEN38_FLASH_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22.jinja"
        ;;
      medium)
        pi_thinking_level="medium"
        args+=" $QWEN38_FLASH_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-medium.jinja"
        ;;
      low)
        pi_thinking_level="low"
        args+=" $QWEN38_FLASH_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-low.jinja"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-off.jinja"
        ;;
    esac

    kv=$(gum choose --header "KV cache quantization" --selected "f16  F16" \
      "f16  F16" \
      "q8   Q8_0") || exit 1
    case "${kv%%[ ]*}" in
      q8) args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
    ;;
  Tiel-Coder-35B-A3B-MTP-Q8)
    # Tiel's trained MTP head is packaged in the MTP main GGUF; no separate
    # --spec-draft-model path is needed. Keep it on Nathan's Vulkan backend.
    fixed_parallel=1
    args+=" --force-vulkan --cache-ram 0 --cache-reuse 512 --ctx-checkpoints 16 --checkpoint-min-step 2048 --context-shift --slot-prompt-similarity 0.8 --kv-unified --no-mmap --direct-io -ub 1024 -b 2048 -t 16 --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 -fa on"

    mode=$(gum choose --header "thinking / reasoning mode" \
      "on   On" \
      "off  Off") || exit 1
    case "${mode%%[ ]*}" in
      on)
        pi_thinking_level="on"
        args+=" --reasoning on"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --reasoning off --reasoning-budget 0"
        ;;
    esac

    mtp=$(gum choose --header "speculative decoding" --selected "on  MTP" \
      "on  MTP" \
      "off  Base") || exit 1
    case "${mtp%%[ ]*}" in
      on)
        args+=" --spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-p-min 0.75"
        ;;
      off)
        args+=" --spec-type none"
        ;;
    esac

    kv=$(gum choose --header "KV cache quantization" --selected "f16  F16" \
      "f16  F16" \
      "q8   Q8_0") || exit 1
    case "${kv%%[ ]*}" in
      q8) args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
    ;;
  Qwen3.8-*)
    mtp=$(gum choose --header "speculative decoding" --selected "dflash2  DFlash2" \
      "dflash2  DFlash2" \
      "on       MTP" \
      "off      None") || exit 1
    case "${mtp%%[ ]*}" in
      dflash2)
        if [[ "$id" == *"ROCmFP4"* ]]; then
          args+=" --force-laurent --spec-type draft-dflash --spec-draft-model /root/.cache/huggingface/hub/models--agentionai--Qwen3.8-27B-DFlash2-ROCmFP4-FAST-GGUF/snapshots/main/Qwen3.8-27B-DFlash2-Q4_0_ROCMFP4_FAST.gguf --spec-draft-adaptive --spec-draft-n-min 2 --spec-draft-n-max 6 -ctkd q8_0 -ctvd q8_0"
        else
          args+=" --spec-type draft-dflash --spec-draft-model $QWEN38_DFLASH2_DRAFT --spec-draft-n-max 4 -ctkd q8_0 -ctvd q8_0"
        fi
        ;;
      on)
        [[ "$id" == *"ROCmFP4"* ]] && args+=" --force-laurent"
        ;;
      off)
        [[ "$id" == *"ROCmFP4"* ]] && args+=" --force-laurent"
        args+=" --spec-type none"
        ;;
    esac

    effort=$(gum choose --header "thinking / reasoning effort" \
      "xhigh  Xhigh" \
      "medium Medium" \
      "low    Low" \
      "off    Off") || exit 1
    case "${effort%%[ ]*}" in
      xhigh)
        pi_thinking_level="max"
        args+=" $QWEN38_SAMPLING"
        ;;
      medium)
        pi_thinking_level="medium"
        args+=" $QWEN38_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-medium.jinja"
        ;;
      low)
        pi_thinking_level="low"
        args+=" $QWEN38_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-low.jinja"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-off.jinja"
        ;;
    esac

    kv=$(gum choose --header "KV cache quantization" --selected "f16  F16" \
      "f16  F16" \
      "q8   Q8_0") || exit 1
    case "${kv%%[ ]*}" in
      q8) args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
    ;;
  DeepSeek-*)
    effort=$(gum choose --header "thinking / reasoning effort" \
      "max    Max" \
      "high   High" \
      "off    Off") || exit 1
    case "${effort%%[ ]*}" in
      max)
        pi_thinking_level="max"
        args+=" --reasoning on --reasoning-effort max"
        ;;
      high)
        pi_thinking_level="high"
        args+=" --reasoning on --reasoning-effort high"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --reasoning off --reasoning-budget 0"
        ;;
    esac

    mtp=$(gum choose --header "speculative decoding" --selected "on  MTP" \
      "on  MTP" \
      "off  None") || exit 1
    [[ "${mtp%%[ ]*}" == "off" ]] && args+=" --spec-type none"
    args+=" $DS4FLASH_SAMPLING"

    kv=$(gum choose --header "KV cache quantization" --selected "f16  F16" \
      "f16  F16" \
      "q8   Q8_0") || exit 1
    case "${kv%%[ ]*}" in
      q8) args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
    ;;
  Qwen3.6-MoE-*)
    mode=$(gum choose --header "thinking / reasoning mode" \
      "on   On" \
      "off  Off") || exit 1
    case "${mode%%[ ]*}" in
      on)
        pi_thinking_level="on"
        args+=" --reasoning on"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --reasoning off --reasoning-budget 0"
        ;;
    esac

    mtp=$(gum choose --header "speculative decoding" --selected "on  MTP" \
      "on  MTP" \
      "off  None") || exit 1
    [[ "${mtp%%[ ]*}" == "off" ]] && args+=" --spec-type none"
    args+=" $QWEN_SAMPLING"

    kv=$(gum choose --header "KV cache quantization" --selected "f16  F16" \
      "f16  F16" \
      "q8   Q8_0") || exit 1
    case "${kv%%[ ]*}" in
      q8) args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
    ;;
  *)
    die "unsupported local model: $id"
    ;;
esac

# The standard Qwen3.8 Q4/Q6 models can be compared across the current
# engines and the halo-box builds. ROCmFP4 remains pinned to Laurent because
# its quantization/layout is not assumed to work in the new fork.
if [[ "$id" == Qwen3.8-* || "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS ]] && [[ "$id" != *ROCmFP4* ]]; then
  if [[ -z "$halo_backend" ]]; then
    halo_backend=$(gum choose --header "Qwen3.8 backend" \
      --selected "current     existing Nathan/Laurent path" \
      "current     existing Nathan/Laurent path" \
      "halo-vulkan halo-box Vulkan/RADV" \
      "halo-rocm   halo-box ROCm/HIP") || exit 1
    halo_backend="${halo_backend%%[ ]*}"
  fi
  case "$halo_backend" in
    current|default) ;;
    halo-vulkan)
      # The fixed Flash aliases already emitted their dispatch flag. For the
      # generic Flash choice, replace the current Nathan-only flags instead of
      # passing two backend selectors to the wrapper.
      if [[ "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS || "$id" == Qwen3.8-Flash-Next-* ]]; then
        args="${args/ --force-vulkan/}"
        args="${args/ --tensor-read-lazy auto/}"
      fi
      [[ "$fixed_halo_backend" == "halo-vulkan" ]] || args+=" --force-halo-vulkan"
      ;;
    halo-rocm)
      if [[ "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS || "$id" == Qwen3.8-Flash-Next-* ]]; then
        args="${args/ --force-vulkan/}"
        args="${args/ --tensor-read-lazy auto/}"
      fi
      [[ "$fixed_halo_backend" == "halo-rocm" ]] || args+=" --force-halo-rocm"
      ;;
    *) die "unsupported LEM_HALO_BACKEND: $halo_backend (use current, halo-vulkan, or halo-rocm)" ;;
  esac

  # The halo fork exposes the Qwen3.8 Flash PLE as --ngram-on-disk rather
  # than Nathan's --tensor-read-lazy option. It is backend-independent.
  if [[ "$halo_backend" == halo-vulkan || "$halo_backend" == halo-rocm ]] && \
     [[ "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS || "$id" == Qwen3.8-Flash-Next-* ]]; then
    args+=" --ngram-on-disk"
  fi

  # Optional runtime profiles expose fork-specific environment switches without
  # allowing arbitrary process arguments through the Lemonade API.
  halo_profile="${LEM_HALO_PROFILE:-default}"
  case "$halo_profile" in
    default) ;;
    vk-perf|vk-no-split)
      [[ "$halo_backend" == halo-vulkan ]] || die "$halo_profile requires LEM_HALO_BACKEND=halo-vulkan"
      [[ "$halo_profile" == vk-perf ]] && args+=" --halo-env GGML_VK_PERF_LOGGER=1"
      [[ "$halo_profile" == vk-no-split ]] && args+=" --halo-env GGML_VK_MMV_NO_SPLIT=1"
      ;;
    rocm-blocking|rocm-async)
      [[ "$halo_backend" == halo-rocm ]] || die "$halo_profile requires LEM_HALO_BACKEND=halo-rocm"
      [[ "$halo_profile" == rocm-blocking ]] && args+=" --halo-env HIP_LAUNCH_BLOCKING=1"
      [[ "$halo_profile" == rocm-async ]] && args+=" --halo-env HIP_LAUNCH_BLOCKING=0"
      ;;
    reasoning-budget-4k|reasoning-budget-8k)
      [[ "$halo_backend" == halo-vulkan || "$halo_backend" == halo-rocm ]] || die "$halo_profile requires a Halo backend"
      args+=" --reasoning-budget-enable --reasoning-budget $([[ "$halo_profile" == reasoning-budget-4k ]] && printf 4096 || printf 8192)"
      ;;
    *) die "unsupported LEM_HALO_PROFILE: $halo_profile (use default, vk-perf, vk-no-split, rocm-blocking, rocm-async, reasoning-budget-4k, or reasoning-budget-8k)" ;;
  esac
fi

if (( fixed_parallel )); then
  args+=" --parallel 1"
else
  par=$(gum choose --header "parallel slots" --selected "1" "1" "2") || exit 1
  args+=" --parallel $par"
fi
args=${args# }

note="loading $selection  [override: $args]"
if ! curl -sS -m 10 "$LEM_API/models" 2>/dev/null | grep -q "\"id\"[[:space:]]*:[[:space:]]*\"$id\""; then
  note="first load of $selection: downloading weights (several minutes) then loading  [override: $args]"
fi

load_json=$(python3 -c 'import json, sys; print(json.dumps({"model_name": sys.argv[1], "llamacpp_args": sys.argv[2]}))' "$id" "$args")
resp=$(gum spin --show-output --title "$note" -- \
  curl -sS -m 3600 -X POST "$LEM_API/load" \
  -H 'Content-Type: application/json' -d "$load_json")

if printf '%s' "$resp" | grep -q '"status"[[:space:]]*:[[:space:]]*"success"'; then
  if [[ -n "${LEM_THINKING_STATE_FILE:-}" ]]; then
    printf '%s\n' "$pi_thinking_level" > "$LEM_THINKING_STATE_FILE"
  fi
  printf '%s\n' "$resp"
  exit 0
fi
printf '%s\n' "load failed: ${resp:-timed out; check 'podman logs lemonade' or 'lem-status'}" >&2
exit 1
