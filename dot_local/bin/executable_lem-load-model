#!/usr/bin/env bash
# Load one local Lemonade model using the same interactive settings used by
# the normal pi/beta wrappers. The provider/model target is configured by the
# caller; this command only handles Lemonade's resident local model.
#
# Menu standard (every model, same order, same column alignment):
#   speculative decoding -> thinking / reasoning -> kv cache quantization
#   (Q8 default) -> parallel slots (only when the model allows two slots).
# The execution backend is pinned by the pi-pick-local-model row
# (@halo-vulkan / @halo-rocm suffix) or by LEM_HALO_BACKEND; there is no
# interactive backend menu.
set -euo pipefail

LEM_API=${LEM_API:-http://127.0.0.1:13305/api/v1}
QWEN_SAMPLING="--temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0"
QWEN38_SAMPLING="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0"
QWEN38_FLASH_SAMPLING="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0 --repeat-penalty 1.0"
QWEN38_DFLASH2_DRAFT="/root/.cache/huggingface/hub/models--incoai--Qwen3.8-27B-DFlash2-GGUF/snapshots/main/Qwen3.8-27B-DFlash2-Q4_K_M.gguf"
# The merged qwen4exp ROCm engine can borrow the target's embeddings/LM head
# from the shared sidecar, saving about 1.3 GiB versus the full sidecar. Keep
# the full file for the pre-merge Vulkan/canonical paths.
QWEN38_FLASH_MTP_FULL="/root/.cache/huggingface/qwen3.8-flash-next/Qwen3.8-Flash-Next-MTP-Q8_0.gguf"
QWEN38_FLASH_MTP_SHARED="/root/.cache/huggingface/qwen3.8-flash-next/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf"

usage() {
  cat <<'EOF'
Usage:
  lem-load-model MODEL_ID

Load a local Lemonade model. Every model gets the same menu sequence:
speculative decoding -> thinking / reasoning -> kv cache quantization
(Q8 default) -> parallel slots (when the model allows two slots).
The backend is pinned by the pi-pick-local-model row suffix
(@halo-vulkan / @halo-rocm) or by LEM_HALO_BACKEND; no backend menu exists.
EOF
}

die() {
  printf 'lem-load-model: %s\n' "$*" >&2
  exit 1
}

# --- standardized gum menus -------------------------------------------------
# Headers and column alignment are identical for every model. Keys are padded
# to the widest key in the menu so descriptions line up.

menu_spec_mtp() {
  gum choose --header "speculative decoding" --height 2 --selected "on       MTP" \
    "on       MTP" \
    "off      Base"
}

menu_spec_dense38() {
  gum choose --header "speculative decoding" --height 3 --selected "dflash2  DFlash2" \
    "dflash2  DFlash2" \
    "on       MTP" \
    "off      Base"
}

menu_thinking_effort() {
  gum choose --header "thinking / reasoning" --height 4 --selected "xhigh  Xhigh" \
    "xhigh  Xhigh" \
    "medium Medium" \
    "low    Low" \
    "off    Off"
}

menu_thinking_onoff() {
  gum choose --header "thinking / reasoning" --height 2 --selected "on     On" \
    "on     On" \
    "off    Off"
}

menu_kv_cache() {
  gum choose --header "kv cache quantization" --height 2 --selected "q8   Q8_0" \
    "q8   Q8_0" \
    "f16  F16"
}

menu_parallel_slots() {
  gum choose --header "parallel slots" --height 2 --selected "1" \
    "1" \
    "2"
}

append_kv_flags() {
  local kv
  kv=$(menu_kv_cache) || return 1
  case "${kv%%[ ]*}" in
    q8)  args+=" -ctk q8_0 -ctv q8_0" ;;
    f16) args+=" -ctk f16 -ctv f16" ;;
  esac
}

[[ -n "${1:-}" ]] || { usage >&2; exit 2; }
selection=$1
[[ "$selection" != *$'\n'* && "$selection" != *$'\r'* && "$selection" != *' '* ]] || die "model contains whitespace"

# Backend-pinned selections carry an @halo-vulkan / @halo-rocm suffix from the
# pi/beta picker. Keep the canonical ID for registry lookup and the OpenAI
# model name.
id="$selection"
fixed_halo_backend=""
case "$selection" in
  *@halo-vulkan|*@halo-rocm)
    id="${selection%@*}"
    fixed_halo_backend="${selection##*@}"
    ;;
  *@*)
    die "unsupported model/backend selection: $selection"
    ;;
esac

command -v gum >/dev/null 2>&1 || die "gum is required for local model loading"

curl -sS -m 5 "$LEM_API/health" >/dev/null 2>&1 \
  || die "Lemonade not reachable on $LEM_API (container up? try 'podman start lemonade')"

args=""
pi_thinking_level="unknown"
fixed_parallel=0
halo_backend="${fixed_halo_backend:-${LEM_HALO_BACKEND:-}}"

case "$id" in
  UD-Q4_K_XL|UD-IQ4_XS|Qwen3.8-Flash-Next-*)
    # Qwen3.8-Flash-Next is a qwen4exp model with a very large PLE tensor.
    # The extra-model registry attaches mmproj-F16.gguf; preserve mmap-backed
    # loading while selecting the requested runtime backend.
    fixed_parallel=1
    pi_thinking_level="max"
    if [[ "$halo_backend" == "halo-vulkan" ]]; then
      args+=" --force-halo-vulkan --load-mode mmap --no-host --no-repack --fit off -b 2048 -ub 2048 -ngl 99 --n-cpu-moe 0 -fa on --reasoning on"
    elif [[ "$halo_backend" == "halo-rocm" ]]; then
      # The halo-rocm HIP loader wedges on this model with --load-mode mmap
      # (thread spin, no readiness); default load-mode auto uses a working
      # read path. --no-host/--no-repack are canonical-Vulkan flags and break
      # halo-rocm buffer setup, so the fork's defaults apply here.
      args+=" --force-halo-rocm --fit off -b 2048 -ub 2048 -ngl 99 --n-cpu-moe 0 -fa on --reasoning on"
    else
      args+=" --force-vulkan --load-mode mmap --tensor-read-lazy auto --no-host --no-repack --fit off -b 2048 -ub 2048 -ngl 99 --n-cpu-moe 0 -fa on --reasoning on"
    fi
    # Qwen4Exp has 512 experts but activates only 10 in normal inference;
    # the default empty warmup builds the all-512-expert graph and can exceed
    # Lemonade's 600-second readiness window on this 104 GB model.
    args+=" --no-warmup --cache-ram 4096 --ctx-checkpoints 1 --checkpoint-min-step 2048"

    spec=$(menu_spec_mtp) || exit 1
    case "${spec%%[ ]*}" in
      on)
        mtp_model="$QWEN38_FLASH_MTP_FULL"
        [[ "$halo_backend" == "halo-rocm" ]] && mtp_model="$QWEN38_FLASH_MTP_SHARED"
        args+=" --spec-type draft-mtp --spec-draft-model $mtp_model --spec-draft-n-max 3 --spec-draft-p-min 0.75"
        ;;
      off)
        args+=" --spec-type none"
        ;;
    esac

    effort=$(menu_thinking_effort) || exit 1
    case "${effort%%[ ]*}" in
      xhigh)
        pi_thinking_level="max"
        args+=" $QWEN38_FLASH_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22.jinja"
        ;;
      medium)
        pi_thinking_level="medium"
        args+=" $QWEN38_FLASH_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-medium.jinja"
        ;;
      low)
        pi_thinking_level="low"
        args+=" $QWEN38_FLASH_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-low.jinja"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-off.jinja"
        ;;
    esac

    append_kv_flags || exit 1
    ;;
  Tiel-Coder-35B-A3B-MTP-Q8)
    # Tiel's trained MTP head is packaged in the MTP main GGUF; no separate
    # --spec-draft-model path is needed. Keep it on Nathan's Vulkan backend.
    fixed_parallel=1
    args+=" --force-vulkan --cache-ram 16384 --cache-reuse 512 --ctx-checkpoints 8 --checkpoint-min-step 2048 --context-shift --slot-prompt-similarity 0.8 --kv-unified --no-mmap --direct-io -ub 1024 -b 2048 -t 16 --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 -fa on"

    mode=$(menu_thinking_onoff) || exit 1
    case "${mode%%[ ]*}" in
      on)
        pi_thinking_level="on"
        args+=" --reasoning on"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --reasoning off --reasoning-budget 0"
        ;;
    esac

    spec=$(menu_spec_mtp) || exit 1
    case "${spec%%[ ]*}" in
      on)
        args+=" --spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-p-min 0.75"
        ;;
      off)
        args+=" --spec-type none"
        ;;
    esac

    append_kv_flags || exit 1
    ;;
  Signal-3.8-27B-AP-Q4_K_XL)
    # Signal's GGUF contains the Qwen3.8 MTP draft head. The adaptive flag
    # requires the halo-box Strix Vulkan engine, not Nathan's older Vulkan build.
    fixed_parallel=1
    args+=" --force-halo-vulkan -ngl 999 -fa on --cache-ram 16384 --cache-reuse 512 --ctx-checkpoints 8 --checkpoint-min-step 2048 --context-shift --slot-prompt-similarity 0.8 --kv-unified --no-mmap --direct-io -ub 256 -b 2048 -t 16 --temp 0.7 --top-p 0.95 --top-k 20 --min-p 0"

    spec=$(menu_spec_mtp) || exit 1
    case "${spec%%[ ]*}" in
      on)
        args+=" --spec-type draft-mtp --spec-draft-n-max 4 --spec-draft-adaptive"
        ;;
      off)
        args+=" --spec-type none"
        ;;
    esac

    effort=$(menu_thinking_effort) || exit 1
    case "${effort%%[ ]*}" in
      xhigh)
        pi_thinking_level="max"
        args+=" --reasoning on"
        ;;
      medium)
        pi_thinking_level="medium"
        args+=" --reasoning on --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-medium.jinja"
        ;;
      low)
        pi_thinking_level="low"
        args+=" --reasoning on --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-low.jinja"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --reasoning off --reasoning-budget 0 --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-off.jinja"
        ;;
    esac

    append_kv_flags || exit 1
    ;;
  Qwen3.8-*)
    spec=$(menu_spec_dense38) || exit 1
    case "${spec%%[ ]*}" in
      dflash2)
        args+=" --spec-type draft-dflash --spec-draft-model $QWEN38_DFLASH2_DRAFT --spec-draft-n-max 4 -ctkd q8_0 -ctvd q8_0"
        ;;
      on)
        ;;
      off)
        args+=" --spec-type none"
        ;;
    esac

    effort=$(menu_thinking_effort) || exit 1
    case "${effort%%[ ]*}" in
      xhigh)
        pi_thinking_level="max"
        args+=" $QWEN38_SAMPLING"
        ;;
      medium)
        pi_thinking_level="medium"
        args+=" $QWEN38_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-medium.jinja"
        ;;
      low)
        pi_thinking_level="low"
        args+=" $QWEN38_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-low.jinja"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-off.jinja"
        ;;
    esac

    append_kv_flags || exit 1
    ;;
  Qwen3.6-MoE-*)
    mode=$(menu_thinking_onoff) || exit 1
    case "${mode%%[ ]*}" in
      on)
        pi_thinking_level="on"
        args+=" --reasoning on"
        ;;
      off)
        pi_thinking_level="off"
        args+=" --reasoning off --reasoning-budget 0"
        ;;
    esac

    spec=$(menu_spec_mtp) || exit 1
    [[ "${spec%%[ ]*}" == "off" ]] && args+=" --spec-type none"
    args+=" $QWEN_SAMPLING"

    append_kv_flags || exit 1
    ;;
  *)
    die "unsupported local model: $id"
    ;;
esac

# Backend resolution: the pi/beta picker pins the backend in the selection
# suffix; scripted callers may still use LEM_HALO_BACKEND.
if [[ -n "$fixed_halo_backend" && -n "${LEM_HALO_BACKEND:-}" && "${LEM_HALO_BACKEND}" != "$fixed_halo_backend" ]]; then
  die "$selection conflicts with LEM_HALO_BACKEND=${LEM_HALO_BACKEND}"
fi
if [[ -n "$halo_backend" ]]; then
  case "$id" in
    Qwen3.8-27B-Q4|Qwen3.8-27B-Q6|UD-Q4_K_XL|UD-IQ4_XS|Qwen3.8-Flash-Next-*)
      ;;
    *)
      die "$selection: halo backends are not supported for $id"
      ;;
  esac
fi

# The standard Qwen3.8 Q4/Q6 models can be compared across the current
# engines and the halo-box builds.
if [[ "$id" == Qwen3.8-* || "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS ]]; then
  case "$halo_backend" in
    ""|current|default) ;;
    halo-vulkan)
      # The fixed Flash aliases already emitted their dispatch flag. For the
      # generic Flash choice, replace the current Nathan-only flags instead of
      # passing two backend selectors to the wrapper.
      if [[ "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS || "$id" == Qwen3.8-Flash-Next-* ]]; then
        args="${args/ --force-vulkan/}"
        args="${args/ --tensor-read-lazy auto/}"
      fi
      [[ "$args" == *"--force-halo-vulkan"* ]] || args+=" --force-halo-vulkan"
      ;;
    halo-rocm)
      if [[ "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS || "$id" == Qwen3.8-Flash-Next-* ]]; then
        args="${args/ --force-vulkan/}"
        args="${args/ --tensor-read-lazy auto/}"
      fi
      [[ "$args" == *"--force-halo-rocm"* ]] || args+=" --force-halo-rocm"
      ;;
    *) die "unsupported LEM_HALO_BACKEND: $halo_backend (use current, halo-vulkan, or halo-rocm)" ;;
  esac

  # The halo fork exposes the Qwen3.8 Flash PLE as --ngram-on-disk rather
  # than Nathan's --tensor-read-lazy option. It is backend-independent.
  if [[ "$halo_backend" == halo-vulkan || "$halo_backend" == halo-rocm ]] && \
     [[ "$id" == UD-Q4_K_XL || "$id" == UD-IQ4_XS || "$id" == Qwen3.8-Flash-Next-* ]]; then
    args+=" --ngram-on-disk"
  fi

  # Optional runtime profiles expose fork-specific environment switches without
  # allowing arbitrary process arguments through the Lemonade API.
  halo_profile="${LEM_HALO_PROFILE:-default}"
  case "$halo_profile" in
    default) ;;
    vk-perf|vk-no-split)
      [[ "$halo_backend" == halo-vulkan ]] || die "$halo_profile requires LEM_HALO_BACKEND=halo-vulkan"
      [[ "$halo_profile" == vk-perf ]] && args+=" --halo-env GGML_VK_PERF_LOGGER=1"
      [[ "$halo_profile" == vk-no-split ]] && args+=" --halo-env GGML_VK_MMV_NO_SPLIT=1"
      ;;
    rocm-blocking|rocm-async)
      [[ "$halo_backend" == halo-rocm ]] || die "$halo_profile requires LEM_HALO_BACKEND=halo-rocm"
      [[ "$halo_profile" == rocm-blocking ]] && args+=" --halo-env HIP_LAUNCH_BLOCKING=1"
      [[ "$halo_profile" == rocm-async ]] && args+=" --halo-env HIP_LAUNCH_BLOCKING=0"
      ;;
    reasoning-budget-4k|reasoning-budget-8k)
      [[ "$halo_backend" == halo-vulkan || "$halo_backend" == halo-rocm ]] || die "$halo_profile requires a Halo backend"
      args+=" --reasoning-budget-enable --reasoning-budget $([[ "$halo_profile" == reasoning-budget-4k ]] && printf 4096 || printf 8192)"
      ;;
    *) die "unsupported LEM_HALO_PROFILE: $halo_profile (use default, vk-perf, vk-no-split, rocm-blocking, rocm-async, reasoning-budget-4k, or reasoning-budget-8k)" ;;
  esac
fi

if (( fixed_parallel )); then
  args+=" --parallel 1"
else
  par=$(menu_parallel_slots) || exit 1
  args+=" --parallel $par"
fi
if [[ " $args " != *" --cache-ram "* ]]; then
  args+=" --cache-ram 16384 --cache-reuse 512 --ctx-checkpoints 8 --checkpoint-min-step 2048"
fi
args=${args# }

note="loading $selection  [override: $args]"
if ! curl -sS -m 10 "$LEM_API/models" 2>/dev/null | grep -q "\"id\"[[:space:]]*:[[:space:]]*\"$id\""; then
  note="first load of $selection: downloading weights (several minutes) then loading  [override: $args]"
fi

load_json=$(python3 -c 'import json, sys; print(json.dumps({"model_name": sys.argv[1], "llamacpp_args": sys.argv[2]}))' "$id" "$args")

# Loading over a recently-killed instance races the amdgpu GTT teardown and
# wedges the halo-rocm HIP loader (Lemonade's reload path kills and respawns
# immediately, and 76 GiB of GTT takes minutes to drain). Unload, wait for
# Lemonade to report idle, then wait for the host-side GTT to actually drain.
if [[ -n "$halo_backend" ]]; then
  curl -sS -m 10 -X POST "$LEM_API/unload" >/dev/null 2>&1 || true
  for _ in {1..15}; do
    curl -sS -m 5 "$LEM_API/health" 2>/dev/null | grep -qE '"model_loaded": ?null' && break
    sleep 2
  done
  gtt_idle=0
  for _ in {1..90}; do
    gtt_idle=1
    for f in /sys/class/drm/card*/device/mem_info_gtt_used; do
      [[ -r "$f" ]] || continue
      if (( $(cat "$f") > 4000000000 )); then
        gtt_idle=0
        break
      fi
    done
    (( gtt_idle )) && break
    sleep 2
  done
  sleep 2
fi

resp=$(gum spin --show-output --title "$note" -- \
  curl -sS -m 3600 -X POST "$LEM_API/load" \
  -H 'Content-Type: application/json' -d "$load_json")

if printf '%s' "$resp" | grep -q '"status"[[:space:]]*:[[:space:]]*"success"'; then
  if [[ -n "${LEM_THINKING_STATE_FILE:-}" ]]; then
    printf '%s\n' "$pi_thinking_level" > "$LEM_THINKING_STATE_FILE"
  fi
  printf '%s\n' "$resp"
  exit 0
fi
printf '%s\n' "load failed: ${resp:-timed out; check 'podman logs lemonade' or 'lem-status'}" >&2
exit 1
