#!/usr/bin/env python3
"""
llm-bench — reproducible Lemonade/llama.cpp speed benchmark.

The benchmark is deliberately a client of the running Lemonade server rather
than a second, hand-maintained llama-server launcher.  It discovers registered
models and their saved recipe arguments from Lemonade, applies only the
requested benchmark overrides, and measures the server's own timings.

Protocol
--------
* target prompt prefill: approximately 2048 new tokens (PP2048)
* target generation: exactly 182 tokens (TG182; EOS is ignored)
* context depths: d0, d30000, d60000 by default
* workloads: prose synthesis and Stata code
* reasoning: always disabled
* cache control: every cell gets a unique nonce at the beginning of its
  context; the context-fill request and its target request share a cache only
  within that one cell.  This makes deep-context decoding measurable without
  reusing another run's prefix.  The target response reports cache_n, so a
  cache miss is visible instead of silently producing a misleading row.

No third-party Python packages are required.  The only runtime dependency is a
reachable Lemonade server at http://127.0.0.1:13305/api/v1.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import math
import os
import re
import shlex
import socket
import statistics
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path
from typing import Any, Callable


SCRIPT_NAME = "llm-bench"
SCRIPT_VERSION = "2.4"
DEFAULT_BASE_URL = "http://127.0.0.1:13305/api/v1"
DEFAULT_OUTDIR = Path.home() / ".local/share/ramalama/benchmarks"
LOCK_PATH = DEFAULT_OUTDIR / "llm-bench.lock"
PP_TARGET = 2048
TG_TARGET = 182
DEFAULT_DEPTHS = [0, 30000, 60000]
DEFAULT_RUNS = 2
PROMPT_VERSION = "builtin-2"


