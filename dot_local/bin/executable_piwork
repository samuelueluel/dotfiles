#!/usr/bin/env python3
"""
piwork - Pi Workspaces & Conversation Stash Manager
Manages workspace folders for Pi CLI sessions (~/.pi/agent/folders/)
"""

import sys
import os
import glob
import json
import shutil
import subprocess
import time
from datetime import datetime
from pathlib import Path

FOLDERS_DIR = os.path.expanduser("~/.pi/agent/folders")
UNFILED_DIR = os.path.expanduser("~/.pi/agent/sessions/--var-home-samuel--")

def ensure_dirs():
    os.makedirs(FOLDERS_DIR, exist_ok=True)
    os.makedirs(UNFILED_DIR, exist_ok=True)

def parse_session_meta(file_path):
    """Fast extraction of metadata from a session JSONL file."""
    meta = {
        "path": file_path,
        "filename": os.path.basename(file_path),
        "mtime": os.path.getmtime(file_path),
        "id": "",
        "cwd": "",
        "name": "",
        "first_prompt": "",
        "turn_count": 0,
    }
    try:
        with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if not line.strip():
                    continue
                if '"session_info"' in line:
                    try:
                        entry = json.loads(line)
                        if entry.get("type") == "session_info" and entry.get("name"):
                            meta["name"] = entry.get("name").strip()
                    except Exception:
                        pass
                elif '"session"' in line and '"type":"session"' in line:
                    try:
                        entry = json.loads(line)
                        if entry.get("type") == "session":
                            meta["id"] = entry.get("id", "")
                            meta["cwd"] = entry.get("cwd", "")
                    except Exception:
                        pass
                elif '"role":"user"' in line:
                    meta["turn_count"] += 1
                    if not meta["first_prompt"]:
                        try:
                            entry = json.loads(line)
                            if entry.get("type") == "message":
                                c = entry.get("message", {}).get("content", "")
                                if isinstance(c, list) and c and isinstance(c[0], dict):
                                    meta["first_prompt"] = c[0].get("text", "").strip().replace("\n", " ")
                                elif isinstance(c, str):
                                    meta["first_prompt"] = c.strip().replace("\n", " ")
                        except Exception:
                            pass
                elif '"role":"assistant"' in line:
                    meta["turn_count"] += 1
    except Exception:
        pass

    display_title = meta["name"] if meta["name"] else (meta["first_prompt"] if meta["first_prompt"] else "Untitled conversation")
    meta["title"] = display_title
    return meta

def format_relative_time(mtime):
    diff = time.time() - mtime
    if diff < 60:
        return "just now"
    if diff < 3600:
        return f"{int(diff // 60)}m ago"
    if diff < 86400:
        return f"{int(diff // 3600)}h ago"
    if diff < 86400 * 7:
        return f"{int(diff // 86400)}d ago"
    dt = datetime.fromtimestamp(mtime)
    return dt.strftime("%b %d")

def get_folders():
    ensure_dirs()
    folders = []
    for item in sorted(os.listdir(FOLDERS_DIR)):
        full_path = os.path.join(FOLDERS_DIR, item)
        if os.path.isdir(full_path) and not item.startswith("."):
            count = len(glob.glob(os.path.join(full_path, "*.jsonl")))
            folders.append({"name": item, "path": full_path, "count": count})
    return folders

def get_sessions_in_folder(folder_name):
    folder_path = os.path.join(FOLDERS_DIR, folder_name)
    if not os.path.isdir(folder_path):
        return []
    files = glob.glob(os.path.join(folder_path, "*.jsonl"))
    metas = [parse_session_meta(f) for f in files]
    metas.sort(key=lambda x: x["mtime"], reverse=True)
    return metas

def get_unfiled_sessions(limit=None):
    if not os.path.isdir(UNFILED_DIR):
        return []
    files = glob.glob(os.path.join(UNFILED_DIR, "*.jsonl"))
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)
    if limit:
        files = files[:limit]
    metas = [parse_session_meta(f) for f in files]
    return metas

def gum_choose(options, header="Choose:", limit=1, no_limit=False, selected=None):
    cmd = ["gum", "choose", f"--header={header}"]
    if no_limit:
        cmd.append("--no-limit")
    elif limit:
        cmd.append(f"--limit={limit}")
    if selected:
        cmd.append(f"--selected={selected}")

    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    stdout, _ = p.communicate(input="\n".join(options))
    if p.returncode != 0:
        return [] if no_limit else None
    lines = [line.strip() for line in stdout.splitlines() if line.strip()]
    if no_limit:
        return lines
    return lines[0] if lines else None

def gum_input(header="Input:", placeholder=""):
    cmd = ["gum", "input", f"--header={header}", f"--placeholder={placeholder}"]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    stdout, _ = p.communicate()
    if p.returncode != 0:
        return None
    return stdout.strip()

# --- CLI COMMANDS ---

def cmd_list():
    folders = get_folders()
    unfiled_count = len(glob.glob(os.path.join(UNFILED_DIR, "*.jsonl")))

    print(f"\033[1;36mPi Conversation Folders\033[0m (~/.pi/agent/folders/)\n")
    if not folders:
        print("  No workspaces created yet. Run 'piwork stash' to stash a conversation into a workspace.")
    else:
        for f in folders:
            print(f"  \033[1;32m📁 {f['name']:<20}\033[0m \033[2m({f['count']} conversations)\033[0m")

    print(f"\n  \033[1;33m📥 Unfiled (Home)\033[0m      \033[2m({unfiled_count} conversations)\033[0m\n")

def cmd_stash(session_path=None, target_folder=None):
    ensure_dirs()
    if not session_path:
        unfiled = get_unfiled_sessions(limit=15)
        if not unfiled:
            print("No unfiled conversations found in home session directory.")
            return

        options = []
        path_map = {}
        for s in unfiled:
            rel_time = format_relative_time(s["mtime"])
            label = f"{rel_time:<10} │ {s['title']}"
            options.append(label)
            path_map[label] = s["path"]

        chosen_label = gum_choose(options, header="Select conversation to stash:")
        if not chosen_label:
            print("Cancelled.")
            return
        session_path = path_map[chosen_label]

    if not target_folder:
        # Pick destination folder
        folders = [f["name"] for f in get_folders()]
        folder_options = ["+ New Folder..."] + folders
        chosen_folder = gum_choose(folder_options, header="Select destination folder:")
        if not chosen_folder:
            print("Cancelled.")
            return

        if chosen_folder == "+ New Folder...":
            new_name = gum_input(header="New Folder Name:", placeholder="e.g. Economics, Music, Detroit-Paper")
            if not new_name:
                print("Cancelled.")
                return
            target_folder = new_name.strip()
        else:
            target_folder = chosen_folder

    dest_dir = os.path.join(FOLDERS_DIR, target_folder)
    os.makedirs(dest_dir, exist_ok=True)
    dest_path = os.path.join(dest_dir, os.path.basename(session_path))

    shutil.move(session_path, dest_path)
    print(f"\033[1;32m✓ Stashed conversation into '{target_folder}'\033[0m")
    print(f"  Destination: {dest_path}")

def cmd_organize():
    ensure_dirs()
    unfiled = get_unfiled_sessions()
    if not unfiled:
        print("No unfiled conversations found.")
        return

    options = []
    path_map = {}
    for s in unfiled:
        rel_time = format_relative_time(s["mtime"])
        label = f"{rel_time:<10} │ {s['title']}"
        options.append(label)
        path_map[label] = s["path"]

    chosen_labels = gum_choose(
        options,
        header="Select conversations to stash (Space to select, Enter to confirm):",
        no_limit=True
    )
    if not chosen_labels:
        print("No conversations selected.")
        return

    folders = [f["name"] for f in get_folders()]
    folder_options = ["+ New Folder..."] + folders
    chosen_folder = gum_choose(folder_options, header="Move selected conversations to:")
    if not chosen_folder:
        print("Cancelled.")
        return

    if chosen_folder == "+ New Folder...":
        new_name = gum_input(header="New Folder Name:", placeholder="e.g. Economics, System")
        if not new_name:
            print("Cancelled.")
            return
        target_folder = new_name.strip()
    else:
        target_folder = chosen_folder

    dest_dir = os.path.join(FOLDERS_DIR, target_folder)
    os.makedirs(dest_dir, exist_ok=True)

    count = 0
    for label in chosen_labels:
        src = path_map.get(label)
        if src and os.path.exists(src):
            dst = os.path.join(dest_dir, os.path.basename(src))
            shutil.move(src, dst)
            count += 1

    print(f"\033[1;32m✓ Stashed {count} conversations into '{target_folder}'\033[0m")

def cmd_rename():
    folders = [f["name"] for f in get_folders()]
    if not folders:
        print("No folders exist to rename.")
        return

    chosen = gum_choose(folders, header="Select folder to rename:")
    if not chosen:
        return

    new_name = gum_input(header=f"Rename '{chosen}' to:", placeholder="New folder name")
    if not new_name or new_name.strip() == chosen:
        print("Cancelled or unchanged.")
        return

    src = os.path.join(FOLDERS_DIR, chosen)
    dst = os.path.join(FOLDERS_DIR, new_name.strip())
    if os.path.exists(dst):
        print(f"Error: Folder '{new_name.strip()}' already exists.")
        return

    os.rename(src, dst)
    print(f"\033[1;32m✓ Renamed folder '{chosen}' → '{new_name.strip()}'\033[0m")

def resolve_stata_project_dir(hint_folder=None, hint_cwd=None):
    home = os.path.realpath(os.path.expanduser("~"))
    candidates = []

    # 1. If hint_cwd is provided, exists, and is not home
    if hint_cwd:
        real_cwd = os.path.realpath(os.path.expanduser(hint_cwd))
        if real_cwd != home and os.path.isdir(real_cwd):
            candidates.append(real_cwd)

    # 2. Check current working directory if not home
    cur_dir = os.path.realpath(os.getcwd())
    if cur_dir != home and os.path.isdir(cur_dir) and cur_dir not in candidates:
        candidates.append(cur_dir)

    # 3. Check ~/Dropbox/Research-2026/
    research_dir = os.path.realpath(os.path.expanduser("~/Dropbox/Research-2026"))
    if hint_folder and hint_folder != "Unfiled":
        cand = os.path.join(research_dir, hint_folder)
        if os.path.isdir(cand) and cand not in candidates:
            candidates.append(cand)

    if os.path.isdir(research_dir):
        for item in sorted(os.listdir(research_dir)):
            full = os.path.join(research_dir, item)
            if os.path.isdir(full) and not item.startswith(".") and full not in candidates:
                candidates.append(full)

    # 4. ~/ado
    ado_dir = os.path.realpath(os.path.expanduser("~/ado"))
    if os.path.isdir(ado_dir) and ado_dir not in candidates:
        candidates.append(ado_dir)

    custom_label = "📁 Enter custom directory path..."
    options = [c.replace(home, "~") for c in candidates] + [custom_label]

    chosen = gum_choose(options, header="Stata Project Directory (write-isolated sandbox):")
    if not chosen:
        return None

    if chosen == custom_label:
        val = gum_input(header="Enter project directory path:", placeholder="~/Dropbox/Research-2026/...")
        if not val:
            return None
        chosen = val.strip()

    resolved = os.path.realpath(os.path.expanduser(chosen))
    if resolved == home:
        print("\033[1;31mError: Stata sandbox cannot mount entire home directory. Write access must be scoped to a project folder.\033[0m")
        return resolve_stata_project_dir(hint_folder, hint_cwd)

    if not os.path.exists(resolved):
        confirm = gum_choose(["Yes, create directory", "No, cancel"], header=f"Directory '{chosen}' does not exist. Create it?")
        if confirm == "Yes, create directory":
            os.makedirs(resolved, exist_ok=True)
        else:
            return None

    return resolved

def cmd_new(folder_name=None, remaining_args=None):
    ensure_dirs()
    if not folder_name:
        folders = [f["name"] for f in get_folders()]
        folder_options = ["Unfiled"] + folders + ["+ New Folder..."]
        chosen = gum_choose(folder_options, header="Start new chat in folder:")
        if not chosen:
            return
        if chosen == "+ New Folder...":
            folder_name = gum_input(header="New folder name:", placeholder="e.g. Economics, System")
            if not folder_name:
                return
            folder_name = folder_name.strip()
        else:
            folder_name = chosen

    # Check for agent override in remaining_args
    target_agent = None
    passthrough_args = []
    if remaining_args:
        i = 0
        while i < len(remaining_args):
            arg = remaining_args[i]
            if arg in ("--agent", "-a") and i + 1 < len(remaining_args):
                target_agent = remaining_args[i + 1].lower()
                i += 2
                continue
            elif arg in ("--pihat", "-H"):
                target_agent = "pihat"
            elif arg in ("--pi", "-p"):
                target_agent = "pi"
            elif arg in ("--betahat",):
                target_agent = "betahat"
            elif arg in ("--beta", "-b"):
                target_agent = "beta"
            else:
                passthrough_args.append(arg)
            i += 1

    if not target_agent:
        agent_options = [
            "pihat    · Cloud frontier (GPT-5.6 Luna / Claude / DeepSeek)",
            "pi       · Local models (Qwen / DeepSeek / Mistral)",
            "betahat  · Stata container (Cloud frontier)",
            "beta     · Stata container (Local models)",
        ]
        prompt_header = f"Launch agent in '{folder_name}':"
        chosen_agent_line = gum_choose(agent_options, header=prompt_header)
        if not chosen_agent_line:
            print("Cancelled.")
            return
        target_agent = chosen_agent_line.split()[0]

    # Determine session dir
    session_arg = ""
    if folder_name != "Unfiled":
        folder_dir = os.path.join(FOLDERS_DIR, folder_name)
        os.makedirs(folder_dir, exist_ok=True)
        session_arg = f"--session-dir '{folder_dir}'"

    extra_args = " " + " ".join(f"'{a}'" for a in passthrough_args) if passthrough_args else ""

    if target_agent in ("betahat", "beta"):
        project_dir = resolve_stata_project_dir(hint_folder=folder_name)
        if not project_dir:
            print("Cancelled.")
            return
        cmd_str = f"{target_agent} '{project_dir}'"
        if session_arg:
            cmd_str += f" {session_arg}"
        if extra_args:
            cmd_str += extra_args
    else:
        cmd_str = f"{target_agent}"
        if session_arg:
            cmd_str += f" {session_arg}"
        if extra_args:
            cmd_str += extra_args

    print(f"\033[1;36mStarting new {target_agent} conversation in '{folder_name}'...\033[0m")
    os.execvp("zsh", ["zsh", "-ic", cmd_str])

def cmd_resume(folder_name=None, remaining_args=None):
    ensure_dirs()
    if not folder_name:
        folders = [f["name"] for f in get_folders()]
        if not folders:
            print("No folders found.")
            return
        folder_name = gum_choose(folders, header="Resume latest conversation in:")
        if not folder_name:
            return

    folder_dir = os.path.join(FOLDERS_DIR, folder_name)
    if not os.path.isdir(folder_dir):
        print(f"Error: Folder '{folder_name}' does not exist.")
        return

    args = ["pi", "--session-dir", folder_dir, "-c"]
    if remaining_args:
        args.extend(remaining_args)

    print(f"\033[1;36mResuming latest conversation in folder '{folder_name}'...\033[0m")
    os.execvp("pi", args)

def cmd_resume_beta(session_path, agent="beta"):
    if not os.path.exists(session_path):
        print(f"Error: Session '{session_path}' not found.")
        return
    meta = parse_session_meta(session_path)
    cwd = meta.get("cwd", "")
    home = os.path.realpath(os.path.expanduser("~"))
    if cwd and os.path.isdir(cwd) and os.path.realpath(cwd) != home:
        project_dir = cwd
    else:
        parent = os.path.dirname(session_path)
        hint = os.path.basename(parent) if parent != UNFILED_DIR else None
        project_dir = resolve_stata_project_dir(hint_folder=hint, hint_cwd=cwd)
        if not project_dir:
            print("Cancelled.")
            return

    cmd_str = f"{agent} '{project_dir}' --session '{session_path}'"
    print(f"\033[1;36mResuming session with {agent} in '{project_dir}'...\033[0m")
    os.execvp("zsh", ["zsh", "-ic", cmd_str])

def cmd_browse():
    folders = get_folders()
    unfiled_count = len(glob.glob(os.path.join(UNFILED_DIR, "*.jsonl")))

    options = [f"📁 {f['name']} ({f['count']})" for f in folders]
    options.append(f"📥 Unfiled ({unfiled_count})")
    options.append("➕ Create new folder")

    chosen = gum_choose(options, header="Pi Folders Dashboard:")
    if not chosen:
        return

    if chosen == "➕ Create new folder":
        name = gum_input(header="Folder name:")
        if name:
            os.makedirs(os.path.join(FOLDERS_DIR, name.strip()), exist_ok=True)
            print(f"✓ Created folder '{name.strip()}'.")
        return

    if chosen.startswith("📁 "):
        folder_name = chosen.split(" ")[1]
        sessions = get_sessions_in_folder(folder_name)
    else:
        folder_name = "Unfiled"
        sessions = get_unfiled_sessions()

    if not sessions:
        print(f"No conversations in '{folder_name}'.")
        return

    sess_options = []
    sess_map = {}
    for s in sessions:
        rel_time = format_relative_time(s["mtime"])
        label = f"{rel_time:<10} │ {s['title']}"
        sess_options.append(label)
        sess_map[label] = s

    chosen_sess_label = gum_choose(sess_options, header=f"Conversations in {folder_name}:")
    if not chosen_sess_label:
        return

    s = sess_map[chosen_sess_label]
    action_options = [
        "▶ Resume with pi (local)",
        "▶ Resume with pihat (cloud)",
        "▶ Resume with betahat (Stata container + cloud)",
        "▶ Resume with beta (Stata container + local)",
        "📁 Move to another folder",
        "🗑️ Delete conversation"
    ]
    action = gum_choose(action_options, header=f"Action for: {s['title'][:40]}")
    if not action:
        return

    if "Resume with pi (" in action:
        os.execvp("zsh", ["zsh", "-ic", f"pi --session '{s['path']}'"])
    elif "Resume with pihat" in action:
        os.execvp("zsh", ["zsh", "-ic", f"pihat --session '{s['path']}'"])
    elif "Resume with betahat" in action:
        cmd_resume_beta(s["path"], agent="betahat")
    elif "Resume with beta" in action:
        cmd_resume_beta(s["path"], agent="beta")
    elif "Move to another folder" in action:
        cmd_stash(s["path"])
    elif "Delete conversation" in action:
        confirm = gum_choose(["No, keep it", "Yes, delete permanently"], header="Are you sure?")
        if confirm == "Yes, delete permanently":
            os.remove(s["path"])
            print(f"✓ Deleted {s['filename']}")

def main():
    if len(sys.argv) < 2:
        cmd_browse()
        return

    subcmd = sys.argv[1].lower()
    if subcmd in ("list", "folders", "ls"):
        cmd_list()
    elif subcmd in ("stash", "mv", "move"):
        target = sys.argv[2] if len(sys.argv) > 2 else None
        folder = sys.argv[3] if len(sys.argv) > 3 else None
        cmd_stash(target, folder)
    elif subcmd in ("organize", "batch", "triage"):
        cmd_organize()
    elif subcmd in ("rename", "mvdir"):
        cmd_rename()
    elif subcmd in ("new", "create"):
        folder = sys.argv[2] if len(sys.argv) > 2 else None
        cmd_new(folder, sys.argv[3:] if len(sys.argv) > 3 else None)
    elif subcmd in ("resume", "continue", "-c"):
        folder = sys.argv[2] if len(sys.argv) > 2 else None
        cmd_resume(folder, sys.argv[3:] if len(sys.argv) > 3 else None)
    elif subcmd == "resume-beta":
        target = sys.argv[2] if len(sys.argv) > 2 else None
        cmd_resume_beta(target, agent="beta")
    elif subcmd == "resume-betahat":
        target = sys.argv[2] if len(sys.argv) > 2 else None
        cmd_resume_beta(target, agent="betahat")
    elif subcmd in ("browse", "ui"):
        cmd_browse()
    elif subcmd in ("help", "--help", "-h"):
        print("Usage: piwork [command] [args]")
        print("\nCommands:")
        print("  piwork                Open interactive dashboard (browse workspaces & sessions)")
        print("  piwork stash          Stash recent unfiled conversation into a workspace")
        print("  piwork organize       Batch-stash multiple conversations into a workspace")
        print("  piwork list           List all workspaces and conversation counts")
        print("  piwork new <folder>   Start a brand new conversation in a workspace (pi/pihat/beta/betahat)")
        print("  piwork resume <folder>Resume latest conversation in a workspace")
        print("  piwork rename         Rename an existing workspace folder")
        print("  piwork help           Show this help message")
    else:
        folders = [f["name"].lower() for f in get_folders()]
        if subcmd in folders:
            cmd_resume(sys.argv[1], sys.argv[2:])
        else:
            print(f"Unknown command: {subcmd}. Run 'piwork help' for usage.")

if __name__ == "__main__":
    main()
