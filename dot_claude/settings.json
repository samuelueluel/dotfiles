{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "canberra-gtk-play -f /usr/share/sounds/freedesktop/stereo/message.oga",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "canberra-gtk-play -f /usr/share/sounds/freedesktop/stereo/dialog-information.oga",
            "async": true
          }
        ]
      }
    ]
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "deny": [
      "mcp__zotero__zotero_search",
      "mcp__zotero__zotero_fetch",
      "Skill(anthropic-skills:morning)",
      "Skill(anthropic-skills:import-memory)",
      "Skill(anthropic-skills:docs)",
      "Skill(claude-in-chrome)",
      "Skill(schedule)",
      "Skill(fewer-permission-prompts)",
      "Skill(claude-api)",
      "Skill(dataviz)",
      "Skill(artifact-design)",
      "Skill(artifact-diagramming)",
      "Skill(artifact-capabilities)",
      "Artifact"
    ]
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "low"
    }
  },
  "theme": "custom:blur-theme"
}
