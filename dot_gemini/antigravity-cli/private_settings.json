{
  "allowNonWorkspaceAccess": true,
  "enableTelemetry": false,
  "model": "Gemini 3.7 Flash (High)",
  "permissions": {
    "allow": [
      "command(*)",
      "mcp(*)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf /*)",
      "command(sudo *)",
      "command(sudo)"
    ],
    "ask": []
  },
  "toolExecutionPolicy": "always-proceed",
  "trustedWorkspaces": [
    "/var/home/samuel"
  ]
}
