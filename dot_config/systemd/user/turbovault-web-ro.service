[Unit]
Description=TurboVault MCP for Open WebUI - READ-ONLY instance (default; only read/search tools)
After=network.target

[Service]
Type=simple
ExecStart=/var/home/samuel/.local/bin/turbovault-http --vault /var/home/samuel/Dropbox/Sam-Obsidian-Vault --config /var/home/samuel/.config/turbovault/config-web.yaml --profile production -t http --host 127.0.0.1 --port 13306 --require-read-only-tools
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
