# Theme
theme = Gruvbox Light
# light0_hard (high contrast). previous: light0_soft = #f2e5bc
background = #f9f5d7
cursor-style = block
shell-integration-features = no-cursor
env = GHOSTTY_PROFILE=write

# Font
font-codepoint-map = U+2764=Adwaita Mono
font-family = ""
font-family = Monaspace Xenon
font-style = Medium
font-style-italic = Italic
font-size = 12
adjust-cell-height = 15%

desktop-notifications = false
confirm-close-surface = false
gtk-single-instance = false
quit-after-last-window-closed = false
# Scrollback buffer size in BYTES (not lines) — 200 MB; ~20x the 10 MB default
# Memory is lazy-allocated; 200 MB of terminal output is far beyond typical use on 125 GiB RAM.
scrollback-limit = 200000000

# Window
background-opacity = 1
window-padding-x = 10
window-padding-y = 1
window-decoration = false

# Keybindings
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+enter=unbind
