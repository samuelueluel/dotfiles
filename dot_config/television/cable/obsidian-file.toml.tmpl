[metadata]
name = "Notes (Obsidian)"
description = "Search Obsidian files by name"

[source]
# Target the vault directly
command = "fd -e md --base-directory {{ .obsidian.vault_path }} | awk '{ match($0, /.*\\//); if (RLENGTH > 0) { dir = substr($0, 1, RLENGTH); file = substr($0, RLENGTH+1); first_slash = index(dir, \"/\"); parent = substr(dir, 1, first_slash); rest_dir = substr(dir, first_slash + 1); printf \"\\033[38;2;208;167;175m%s\\033[36m%s\\033[0m%s\\n\", parent, rest_dir, file; } else { printf \"\\033[0m%s\\n\", $0; } }'"
ansi = true
output = "{strip_ansi}"

[ui]
orientation = "portrait"

[ui.preview_panel]
size = 60
scrollbar = true
word_wrap = true
border_type = "thick"
hidden = false

[preview]
command = "bat --color=always --style=plain --theme=Noctalia \"{{ .obsidian.vault_path }}/{strip_ansi}\""

[keybindings]
enter = "actions:obsidian-open"
alt-space = "actions:obsidian-open"
ctrl-c = "actions:copy"
ctrl-p = "actions:copy-absolute"
ctrl-y = "actions:copy-pi-prompt"

[actions.obsidian-open]
description = "Open in Obsidian (New Tab)"
command = "bash -c '{{ .chezmoi.homeDir }}/.local/bin/tv-action-obsidian.sh \"$@\"' -- {split:\\n:..|map:{strip_ansi|append:'|prepend:'}|join: }"
mode = "execute"
separator = "\n"

[actions.copy]
description = "Copy relative path(s) to clipboard"
command = "printf '%s\n' \"{strip_ansi}\" | wl-copy"
mode = "fork"
separator = "\n"

[actions.copy-absolute]
description = "Copy absolute path(s) to clipboard"
command = "printf '%s\n' \"{strip_ansi}\" | sed 's|^|{{ .obsidian.vault_path }}/|' | wl-copy"
mode = "fork"
separator = "\n"

[actions.copy-pi-prompt]
description = "Copy as 'read <paths>' prompt for Pi"
command = "bash -c 'paths=$(printf \"%s\\n\" \"$1\" | tr \"\\n\" \" \"); printf \"read %s\\n\" \"$paths\" | wl-copy' -- \"{strip_ansi}\""
mode = "fork"
separator = "\n"
