[metadata]
name = "Apps"
description = "Application launcher"

[ui]
ui_scale = 80

[ui.preview_panel]
size = 50
border_type = "thick"
padding = { left = 2, right = 0, top = 1, bottom = 0 }
word_wrap = false
hidden = false

[source]
command = "{{ .chezmoi.homeDir }}/.local/bin/tv-list-apps.py"
display = "{split:;:0}"

[preview]
command = "{{ .chezmoi.homeDir }}/.local/bin/tv-preview-app.py '{}'"

[keybindings]
enter = "actions:app-launch"
alt-space = "actions:app-launch"
ctrl-c = "actions:copy"

[actions.app-launch]
description = "Launch application(s)"
command = "bash -c 'while IFS=\";\" read -r name path; do [ -n \"$path\" ] && niri msg action spawn -- gio launch \"$path\"; done <<< \"$1\"' -- \"{strip_ansi}\""
mode = "execute"
separator = "\n"

[actions.copy]
description = "Copy desktop file path(s)"
command = "bash -c 'while IFS=\";\" read -r name path; do [ -n \"$path\" ] && echo \"$path\"; done <<< \"$1\" | wl-copy' -- \"{strip_ansi}\""
mode = "fork"
separator = "\n"
