# Open WebUI — frontend for the cptr/Pi gateway (LaTeX/markdown).
# Inference, tools, skills, MCP, and model selection run through cptr/pi-poc.
# Managed by systemd (Quadlet); reachable on the LAN at http://<host>:3000.
[Unit]
Description=Open WebUI (frontend → cptr/Pi :13309)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=open-webui
Image=ghcr.io/open-webui/open-webui:main
Network=host
Environment=PORT=3000
Environment=ENABLE_OLLAMA_API=False
Environment=WEBUI_AUTH=True
Environment=WEBUI_NAME=ZBook Local AI
Volume=open-webui:/app/backend/data
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
