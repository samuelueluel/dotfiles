# MCP filesystem server for Open WebUI/Pi — lets the headless client read/edit
# files inside one explicitly shared folder.
#
# Security model: only OpenWebUI-Access-Folder is mounted into the container and
# exposed as the filesystem server root. The server cannot see the rest of
# Samuel's home directory. Published on 127.0.0.1 only — nothing on the LAN
# can reach it.
#
# Endpoint for Open WebUI (Admin Settings -> External Tools):
#   Type: MCP (Streamable HTTP)
#   URL:  http://127.0.0.1:8000/mcp
#   Auth: None
[Unit]
Description=MCP filesystem server (Streamable HTTP for Open WebUI)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mcp-filesystem
Image=docker.io/supercorp/supergateway:latest
PublishPort=127.0.0.1:8000:8000
Volume=/var/home/samuel/OpenWebUI-Access-Folder:/var/home/samuel/OpenWebUI-Access-Folder:rw
SecurityLabelDisable=true
Entrypoint=/bin/sh
Exec=-c 'cd /usr/local/lib/node_modules/supergateway && npm install @modelcontextprotocol/sdk@latest --no-audit --no-fund --loglevel=error >/dev/null 2>&1; exec supergateway --stdio "npx -y @modelcontextprotocol/server-filesystem /var/home/samuel/OpenWebUI-Access-Folder" --outputTransport streamableHttp --port 8000 --streamableHttpPath /mcp'
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
