+def _tool_call_arguments(item: dict) -> dict:
+    """Extract displayable tool arguments without changing the actual call."""
+    arguments = item.get("arguments")
+    if isinstance(arguments, str):
+        try:
+            arguments = json.loads(arguments)
+        except (TypeError, ValueError):
+            return {"input": arguments}
+    if not isinstance(arguments, dict):
+        return {}
+
+    arguments = dict(arguments)
+    arguments.pop("title", None)
+    nested = arguments.get("input")
+    if isinstance(nested, dict) and len(arguments) == 1:
+        return nested
+    return arguments
+
+
+def _inline_code(value: object) -> str:
+    """Wrap a value in Markdown code delimiters without breaking on backticks."""
+    text = str(value).replace("\n", " ")
+    longest_run = 0
+    run = 0
+    for character in text:
+        if character == "`":
+            run += 1
+            longest_run = max(longest_run, run)
+        else:
+            run = 0
+    fence = "`" * (longest_run + 1)
+    return f"{fence}{text}{fence}"
+
+
+def _format_tool_arguments(arguments: dict) -> str:
+    """Render useful tool inputs while omitting payloads such as file contents."""
+    visible = {
+        key: value for key, value in arguments.items() if key not in _TOOL_DISPLAY_OMIT
+    }
+    if not visible:
+        return ""
+
+    if len(visible) == 1:
+        key, value = next(iter(visible.items()))
+        label = _TOOL_DISPLAY_LABELS.get(key, key.replace("_", " ").title())
+        if isinstance(value, (dict, list)):
+            value = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+        return f"**{label}:** {_inline_code(value)}"
+
+    serialized = json.dumps(
+        visible, ensure_ascii=False, sort_keys=True, separators=(",", ":")
+    )
+    return f"**Arguments:** {_inline_code(serialized)}"
+
