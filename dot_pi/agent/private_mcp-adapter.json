{
  "settings": {
    "toolResultRendering": "boxed",
    "deferWithMissingMetadata": true
  },
  "mcpServers": {
    "searxng": {
      "command": "/var/home/samuel/.agents/mcp/searxng/venv/bin/python3",
      "args": [
        "/var/home/samuel/.agents/mcp/searxng/searxng_mcp.py"
      ],
      "disabled": true
    },
    "stata": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "mcp-stata"
      ],
      "lifecycle": "lazy",
      "disabled": true,
      "includeTools": [
        "stata_run",
        "stata_inspect_data",
        "stata_get_results",
        "stata_read_log",
        "stata_load_data",
        "stata_manage_graphs",
        "stata_estimation_plan"
      ],
      "env": {
        "STATA_PATH": "/usr/local/stata19/stata-mp",
        "MCP_STATA_STRUCTURED_COMPANION_TEXT": "compact"
      }
    },
    "turbovault": {
      "command": "/var/home/samuel/.local/bin/turbovault",
      "args": [
        "--vault",
        "/var/home/samuel/Dropbox/Sam-Obsidian-Vault",
        "--config",
        "/var/home/samuel/.config/turbovault/config.yaml",
        "--profile",
        "production"
      ],
      "env": {
        "TURBOVAULT_DOCUMENT_INDEXING_ENABLED": "true",
        "TURBOVAULT_DOCUMENT_MAX_BYTES": "52428800"
      },
      "lifecycle": "lazy",
      "directTools": false,
      "includeTools": [
        "turbovault_read_note",
        "turbovault_write_note",
        "turbovault_edit_note",
        "turbovault_delete_note",
        "turbovault_move_note",
        "turbovault_get_notes_info",
        "turbovault_search",
        "turbovault_advanced_search",
        "turbovault_get_backlinks",
        "turbovault_get_forward_links",
        "turbovault_get_broken_links",
        "turbovault_get_related_notes",
        "turbovault_get_hub_notes",
        "turbovault_suggest_links",
        "turbovault_query_frontmatter_sql",
        "turbovault_inspect_frontmatter",
        "turbovault_search_by_frontmatter",
        "turbovault_semantic_search",
        "turbovault_read_passage",
        "turbovault_embedding_index_status",
        "turbovault_reindex_embeddings",
        "turbovault_manage_tags",
        "turbovault_update_frontmatter",
        "turbovault_list_templates",
        "turbovault_create_from_template",
        "turbovault_generate_index",
        "turbovault_batch_execute",
        "turbovault_get_vault_context",
        "turbovault_quick_health_check"
      ]
    },
    "turbovault_family": {
      "command": "/var/home/samuel/.local/bin/turbovault",
      "args": [
        "--config",
        "/var/home/samuel/.config/turbovault/family.yaml",
        "--profile",
        "production"
      ],
      "env": {
        "TURBOVAULT_DOCUMENT_INDEXING_ENABLED": "true",
        "TURBOVAULT_DOCUMENT_MAX_BYTES": "52428800",
        "XDG_CACHE_HOME": "/var/home/samuel/.cache/turbovault-family"
      },
      "lifecycle": "lazy",
      "directTools": false,
      "includeTools": [
        "read_note",
        "write_note",
        "edit_note",
        "delete_note",
        "move_note",
        "get_notes_info",
        "search",
        "advanced_search",
        "get_backlinks",
        "get_forward_links",
        "get_broken_links",
        "get_related_notes",
        "get_hub_notes",
        "suggest_links",
        "query_frontmatter_sql",
        "inspect_frontmatter",
        "search_by_frontmatter",
        "semantic_search",
        "read_passage",
        "embedding_index_status",
        "reindex_embeddings",
        "manage_tags",
        "update_frontmatter",
        "list_templates",
        "create_from_template",
        "generate_index",
        "batch_execute",
        "get_vault_context",
        "quick_health_check"
      ],
      "disabled": true
    },
    "lastfm": {
      "command": "mcp-lastfm",
      "lifecycle": "lazy",
      "disabled": true,
      "env": {
        "MCP_LASTFM_API_KEY": "57b159cbe17c3dd01a82cd0122479750",
        "MCP_LASTFM_USERNAME": "samuelueluel"
      }
    },
    "zotero": {
      "url": "http://127.0.0.1:13308/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "excludeTools": [
        "zotero_search",
        "zotero_fetch"
      ]
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
