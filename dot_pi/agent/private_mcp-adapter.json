      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    },
    "cloudflare-observability": {
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    }
  }
