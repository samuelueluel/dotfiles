{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "theme": "noctalia",
  "skills": [
    "/var/home/samuel/.agents/skills",
    "-/var/home/samuel/.agents/skills/auto",
    "-/var/home/samuel/.agents/skills/mode",
    "-/var/home/samuel/.agents/skills/manual"
  ],
  "enableSkillCommands": true,
  "packages": [
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "index.ts"
      ],
      "settings": {
        "outputGuard": {
          "detailsMaxBytes": 1048576,
          "maxBytes": 1048576,
          "maxLines": 50000
        }
      }
    },
    {
      "source": "npm:pi-agent-extensions",
      "extensions": [
        "extensions/answer/index.ts",
        "extensions/ask-user/index.ts",
        "extensions/btw/index.ts",
        "extensions/files/index.ts",
        "extensions/handoff/index.ts",
        "extensions/loop/index.ts",
        "extensions/notify/index.ts",
        "extensions/sessions/index.ts",
        "extensions/todos/index.ts"
      ]
    },
    {
      "source": "npm:pi-markdown-preview"
    },
    {
      "source": "npm:pi-web-access"
    },
    "extensions/pi-tool-display",
    "npm:@tintinweb/pi-subagents",
    "extensions/pi-advisor"
  ],
  "extensions": [
    "extensions/modes.ts",
    "extensions/powerline-footer.ts"
  ],
  "lastChangelogVersion": "0.84.2",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 40000
  }
}