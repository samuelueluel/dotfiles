{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "theme": "noctalia",
  "skills": [
    "/var/home/samuel/.agents/skills",
    "-/var/home/samuel/.agents/skills/auto",
    "-/var/home/samuel/.agents/skills/mode",
    "-/var/home/samuel/.agents/skills/manual"
  ],
  "enableSkillCommands": true,
  "packages": [
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "index.ts"
      ],
      "settings": {
        "outputGuard": {
          "detailsMaxBytes": 1048576,
          "maxBytes": 1048576,
          "maxLines": 50000
        }
      }
    },
    {
      "source": "npm:pi-agent-extensions",
      "extensions": [
        "extensions/answer/index.ts",
        "extensions/btw/index.ts",
        "extensions/files/index.ts",
        "extensions/loop/index.ts"
      ]
    },
    {
      "source": "npm:pi-web-access"
    },
    "npm:pi-tool-display",
    "npm:pi-ask-user",
    "local-packages/pi-permission-system",
    "npm:@tintinweb/pi-subagents",
    "local-packages/pi-agent-beautify",
    "npm:@juicesharp/rpiv-todo@2.8.0",
    {
      "source": "npm:@kennyfrc/pi-system-reminders@0.2.0",
      "extensions": []
    },
    "local-packages/rpiv-advisor-lean",
    "local-packages/pi-smart-compact",
    "local-packages/pi-compact-transcript"
  ],
  "extensions": [
    "extensions/agent-title.ts",
    "extensions/session-state.ts",
    "extensions/subagent-profile.ts",
    "extensions/permission-mode.ts",
    "extensions/powerline-footer.ts",
    "extensions/todo-reminders.ts",
    "extensions/workflow-invariants.ts"
  ],
  "lastChangelogVersion": "0.85.1",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "smartCompact": {
    "mode": "auto",
    "profile": "balanced",
    "summaryModel": "openai-codex/gpt-5.6-luna",
    "segmentationModel": "openai-codex/gpt-5.6-luna",
    "verificationModel": "openai-codex/gpt-5.6-luna",
    "summaryThinkingLevel": "high",
    "segmentationThinkingLevel": "high",
    "autoTriggerTimeoutMs": 300000,
    "codexMaxCallMs": 300000,
    "maxLatencyMs": 0,
    "autoTrigger": true,
    "autoTriggerStrategy": "settled",
    "minContextPercent": 80,
    "requireApproval": false,
    "zeroCallEnabled": true,
    "backupEnabled": true,
    "scrubSecrets": true,
    "agentToolAccess": "disabled",
    "contextGraphEnabled": false,
    "showStatus": false
  },
  "outputPad": 0
}