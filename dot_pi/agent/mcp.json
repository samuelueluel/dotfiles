{
  "mcpServers": {
    "searxng": {
      "command": "/var/home/samuel/.agents/mcp/searxng/venv/bin/python3",
      "args": ["/var/home/samuel/.agents/mcp/searxng/searxng_mcp.py"]
    },
    "stata": {
      "command": "uvx",
      "args": ["--with", "mcp<2.0.0", "mcp-stata"],
      "lifecycle": "lazy",
      "env": {
        "STATA_PATH": "/usr/local/stata19/stata-mp",
        "MCP_STATA_STRUCTURED_COMPANION_TEXT": "compact"
      }
    },
    "turbovault": {
      "command": "turbovault",
      "args": [
        "--vault",
        "/var/home/samuel/Dropbox/Sam-Obsidian-Vault",
        "--config",
        "/var/home/samuel/.config/turbovault/config.yaml",
        "--profile",
        "production"
      ],
      "lifecycle": "lazy"
    }
  }
}
