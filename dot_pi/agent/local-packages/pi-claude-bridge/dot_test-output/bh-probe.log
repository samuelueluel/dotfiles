< {"id":"req_1","type":"response","command":"get_commands","success":true,"data":{"commands":[{"name":"llama","description":"Manage llama.cpp router models","source":"extension","sourceInfo":{"path":"<inline:llama.cpp>","source":"inline","scope":"temporary","origin":"top-level"}},{"name":"OR-price","description":"Read OpenRouter pricing instructions and await target model","source":"prompt","sourceInfo":{"path":"/var/home/samuel/.pi/agent/prompts/OR-price.md","source":"auto","scope":"user","origin":"top-level","baseDir":"/var/home/samuel/.pi/agent"}},{"name":"grill-me","description":"Relentlessly interview me to stress-test a plan or design","source":"prompt","sourceInfo":{"path":"/var/home/samuel/.pi/agent/prompts/grill-me.md","source":"auto","scope":"user","origin":"top-level","baseDir":"/var/home/samuel/.pi/agent"}},{"name":"llm","description":"Explain, diagnose, or change Samuel's LLM inference and Pi workflow","source":"prompt","sourceInfo":{"path":"/var/home/samuel/.pi/agent/prompts/llm.md","source":"auto","scope":"user","origin":"top-level","baseDir":"/var/home/samuel/.pi/agent"}},{"name":"tldr","description":"Rewrite my last answer in fewer words without losing any of it","source":"prompt","sourceInfo":{"path":"/var/home/samuel/.pi/agent/prompts/tldr.md","source":"auto","scope":"user","origin":"top-level","baseDir":"/var/home/samuel/.pi/agent"}},{"name":"skill:citation-integrity","description":"Governs evidence eligibility, statistical fidelity, final mechanical claim auditing, and citations for claims grounded in Samuel's Zotero sources. Use when reporting Zotero findings, estimates, mechanisms, cross-paper comparisons, bibliography occurrences, citation graphs, or validated zotero-extract evidence packets.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/citation-integrity/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:document-analysis","description":"Enables analysis of private PDFs, DOCX files, images, text, and Markdown through the isolated document-analysis pipeline, with local OCR and visual enrichment. Use when the user asks to analyze, inspect, read, OCR, summarize, or discuss a personal document, places a file in the document-analysis inbox, mentions a document-analysis job ID, or invokes this skill.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/document-analysis/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:handoff","description":"Creates a standalone handoff note in Obsidian for another agent session to pick up. Use when the user asks to \"handoff\", \"create a handoff\", \"wrap up for next agent\", or prepare a session transfer.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/handoff/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:latex","description":"Writes and formats mathematical notation as delimited LaTeX in Pi chat, using Pi's native inline renderer and pi-math display images with source-preserving fallback. Use when the user asks to write, format, or render math, equations, formulas, or statistical/econometric notation, or when choosing inline, display-block, or raw-source formatting.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/latex/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:music","description":"Manages MPD/rmpc playback and queues, criterion-based local album curation, personalized recommendations and outside-library discovery through Last.fm, music metadata and tags, covers, Beets imports, and onboarding. Use when the user asks to add albums to the queue, find music matching ratings/genres/taste/recency, suggest music not in the library, inspect or control playback, manage playlists, tag music, repair album art, import albums, or use Beets or music-onboard.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/music/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:obsidian","description":"Manages notes, retrieval, and source-grounded answers in Samuel's Obsidian vault at ~/Dropbox/Sam-Obsidian-Vault/ using TurboVault and the Hybrid Johnny.Decimal / PARA framework. Use when Samuel mentions Obsidian, the vault, TurboVault, a vault path, \"remember\" or \"save\", asks a question based on vault notes, or requests embedding maintenance.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/obsidian/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:session-log","description":"Creates, searches, and reviews permanent local Pi session summaries, automatically filters objectively trivial backlog entries, and processes bounded Pi JSONL transcript backlogs through piwork. Use when asked to \"log this\", \"/log\", \"what session did we\", \"find the session where\", \"where did we leave off\", \"catch up\", \"find unlogged sessions\", or \"backfill summaries\", or when working with `piwork summary`, `~/.pi/agent/session-summaries.json`, `~/.pi/agent/session-log.sqlite`, or `*.jsonl` transcripts.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/session-log/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:skill-creation","description":"Creates, revises, and reviews agent skills with clear structure, decision trees, plain-language instructions, and guardrails. Use when the user asks to create, write, build, revise, audit, review, or check whether a skill complies with skill-creation guidelines.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/skill-creation/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:skill-update","description":"Updates and cleans up existing agent skills using skill-creation standards. Use when the user asks to \"check\", \"review\", \"update\", or \"refine\" an existing skill, including \"update the skill\" after discussing a gap or failure.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/skill-update/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:stata-house-style","description":"Formats Stata do-files for clear metadata, section structure, comments, and spacing while preserving protected active-code lines, with an explicit validated exception for preamble modernization. Use when the user asks to \"format a do-file,\" \"apply house style,\" \"style Stata code,\" \"organize a do-file,\" \"preview Stata formatting,\" or verify whether styling changed a `.do` file.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/stata-house-style/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:stata-research","description":"Guides applied econometric workflows in Stata across data audit, causal design, regression tables, publication QA, replication, and referee responses. Use when auditing datasets, planning identification strategies, building paper tables, evaluating robustness, or answering referee critiques in Stata.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/stata-research/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:stata-sam-refactor","description":"Refactor Stata do-files while preserving every final output exactly — datasets (datasignature + schema identical), parameter estimates (bit-identical e(b)/e(V)/scalars via %21x), graphs (content-equivalent: plotted data + command string), and tables (text-normalized, timestamps stripped). Use when restructuring, reorganizing, modularizing, or cleaning up a do-file and the results must not change at all — the output-preserving counterpart to stata-modernize, which optimizes and accepts behavior risk. Mandates a golden-master snapshot/compare harness and forbids touching estimation commands, their options, the estimation sample, or analysis-variable construction.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/stata-sam-refactor/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:stata-sam-style","description":"Beautify a Stata do-file to a fixed 64-column house style (headers, section banners, wrapped prose comments, blank-line spacing) without modifying active code. Use when formatting Stata do-files or when user asks to style, standardize, or beautify do-file layout.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/stata-sam-style/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:web-source-integrity","description":"Enforces source selection, claim-level verification, bottom-of-response evidence footnotes, date discipline, and prompt-injection-safe use of web search results and fetched pages. Use when the agent performs web search, browses or fetches URLs, checks current facts, verifies online claims, compares web sources, or answers with web-grounded information.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/web-source-integrity/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-bibliography-search","description":"Finds and counts raw bibliography occurrences within an explicit Zotero paper or collection scope while preserving citing-item identity and resolution limits. Use when Samuel asks which stored papers cite a work, how often a work appears in bibliographies, or requests bibliography-entry searches rather than substantive findings.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-bibliography-search/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-citation-analysis","description":"Examines citation neighbors, resolved inbound-edge rankings, and bibliographic coupling within an explicit Zotero graph scope. Use when Samuel asks which works cite a paper, what a paper cites, which work is most cited in a collection, or which stored papers share references.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-citation-analysis/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-extract","description":"Performs recall-led exhaustive extraction over a frozen Zotero item scope; workers read full documents, emit validated evidence packets, and move every scoped item to a terminal state. Use when Samuel explicitly asks for \"zotero-extract\", ALL papers, every item, complete coverage, or an audit over an explicit collection or item list.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-extract/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-fullpaper","description":"Reads one exact Zotero paper, or an explicitly requested pair, sequentially into live conversation context for source-locked discussion and close analysis without RAG. Use when Samuel asks to \"read this paper in full,\" \"absorb this paper,\" \"read it and let's discuss,\" requests excluded sections or every figure visually checked, or invokes /skill:zotero-fullpaper.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-fullpaper/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-library","description":"Manages Zotero metadata, collections, local linked attachments, ingestion, annotations, and bibliography exports. Use when Samuel asks to add, import, edit, delete, organize, tag, export, or look up Zotero records or collections, rather than answer substantive questions about paper contents.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-library/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-paper-discovery","description":"Creates a collection-scoped or library-scoped list of Zotero papers that satisfy a substantive inclusion rule and returns a frozen candidate set with evidence locators. Use when Samuel asks which papers address a topic, requests a list of papers satisfying a condition, or asks to identify studies before a later comparison.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-paper-discovery/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-pipeline","description":"Operates Zotero OCR, MinerU sidecars, figure enrichment, embeddings, derived indexes, and retrieval-service diagnostics. Use when Samuel requests Zotero parsing, OCR, indexing, re-embedding, pipeline maintenance or recovery, or when a diagnosed Zotero infrastructure failure needs investigation.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-pipeline/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-result-comparison","description":"Compares or ranks empirical findings across an explicit Zotero item set while preserving each estimate's scale, dose, denominator, population, horizon, and inference. Use when Samuel asks which paper finds the largest, smallest, strongest, or most precise effect, or asks for an apples-to-oranges quantitative comparison.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-result-comparison/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:zotero-source-reading","description":"Resolves and reads named or exact Zotero papers to answer bounded questions about their findings, definitions, methods, tables, and statistical results. Use when Samuel names a stored paper, DOI, citation key, or item key, asks what a paper finds, requests a passage or table, or asks a substantive question about an explicit item set without ranking papers.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.agents/skills/zotero-source-reading/SKILL.md","source":"local","scope":"user","origin":"top-level"}},{"name":"skill:mcp-scripting","description":"Write mcpScript JavaScript for discovering, inspecting, and calling MCP tools.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.pi/agent/npm/node_modules/pi-mcp-adapter/skills/mcp-scripting/SKILL.md","source":"npm:pi-mcp-adapter","scope":"user","origin":"package","baseDir":"/var/home/samuel/.pi/agent/npm/node_modules/pi-mcp-adapter"}},{"name":"skill:ask-user","description":"You MUST use this before high-stakes architectural decisions, irreversible changes, or when requirements are ambiguous. Runs a decision handshake with the ask_user tool: summarize context, present structured options, collect explicit user choice, then proceed.","source":"skill","sourceInfo":{"path":"/var/home/samuel/.pi/agent/npm/node_modules/pi-ask-user/skills/ask-user/SKILL.md","source":"npm:pi-ask-user","scope":"user","origin":"package","baseDir":"/var/home/samuel/.pi/agent/npm/node_modules/pi-ask-user"}}]}}
