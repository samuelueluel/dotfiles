{
  "settings": {
    "toolResultRendering": "boxed",
    "deferWithMissingMetadata": true
  },
  "mcpServers": {
    "turbovault": {
      "command": "/var/home/samuel/.local/bin/turbovault",
      "args": [
        "--vault",
        "/var/home/samuel/Dropbox/Sam-Obsidian-Vault",
        "--config",
        "/var/home/samuel/.config/turbovault/config.yaml",
        "--profile",
        "production"
      ],
      "env": {
        "TURBOVAULT_DOCUMENT_INDEXING_ENABLED": "true",
        "TURBOVAULT_DOCUMENT_MAX_BYTES": "52428800"
      },
      "lifecycle": "lazy",
      "directTools": false,
      "includeTools": [
        "turbovault_read_note",
        "turbovault_write_note",
        "turbovault_edit_note",
        "turbovault_delete_note",
        "turbovault_move_note",
        "turbovault_get_notes_info",
        "turbovault_search",
        "turbovault_advanced_search",
        "turbovault_get_backlinks",
        "turbovault_get_forward_links",
        "turbovault_get_broken_links",
        "turbovault_get_related_notes",
        "turbovault_get_hub_notes",
        "turbovault_suggest_links",
        "turbovault_query_frontmatter_sql",
        "turbovault_inspect_frontmatter",
        "turbovault_search_by_frontmatter",
        "turbovault_semantic_search",
        "turbovault_read_passage",
        "turbovault_embedding_index_status",
        "turbovault_reindex_embeddings",
        "turbovault_manage_tags",
        "turbovault_update_frontmatter",
        "turbovault_list_templates",
        "turbovault_create_from_template",
        "turbovault_generate_index",
        "turbovault_batch_execute",
        "turbovault_get_vault_context",
        "turbovault_quick_health_check"
      ]
    },
    "zotero": {
      "url": "http://127.0.0.1:13308/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "excludeTools": [
        "zotero_search",
        "zotero_fetch"
      ]
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    },
    "cloudflare-bindings": {
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    },
    "cloudflare-builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    },
    "cloudflare-observability": {
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "lifecycle": "lazy",
      "directTools": false,
      "disabled": true
    }
  }
}
