# lem-status: show all loaded models across every slot category, cptr/Open WebUI, Ramalama, and active Pi sessions
lem-status() {
  local _cptr_workspace _cptr_model_file _cptr_settings_file
  _cptr_workspace=${PI_CPTR_WORKSPACE:-"$HOME/Dropbox/OpenWebUI-Writable/pi-poc"}
  _cptr_model_file="$_cptr_workspace/.cptr/model"
  _cptr_settings_file="$_cptr_workspace/.pi/settings.json"

  local _coder_id _embedder_id _reranker_id _vlm_id
  _coder_id=$(curl -sf -m 2 "http://localhost:8081/v1/models" 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  _embedder_id=$(curl -sf -m 2 "http://localhost:8082/v1/models" 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  _reranker_id=$(curl -sf -m 2 "http://localhost:8083/v1/models" 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  _vlm_id=$(curl -sf -m 2 "http://localhost:8084/v1/models" 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)

  python3 - \
    "$(curl -s -m 5 "$LEM_API/health" 2>/dev/null || true)" \
    "$_cptr_model_file" \
    "$_cptr_settings_file" \
    "${_coder_id:-}" \
    "${_embedder_id:-}" \
    "${_reranker_id:-}" \
    "${_vlm_id:-}" <<'PY'
import sys, json, os, glob

c_bold = "\033[1m"
c_dim = "\033[90m"
c_cyan = "\033[36m"
c_green = "\033[32m"
c_yellow = "\033[33m"
c_reset = "\033[0m"

def banner(title, extra=""):
    width = 62
    title_part = f"── {title} "
    extra_part = f" {extra} ──" if extra else "──"
    fill_len = width - len(title_part) - len(extra_part)
    line = "─" * max(2, fill_len)
    if extra:
        print(f"{c_cyan}{c_bold}── {title} {c_dim}{line} {c_green}{extra}{c_reset}{c_cyan}{c_bold} ──{c_reset}")
    else:
        print(f"{c_cyan}{c_bold}── {title} {c_dim}{line}{c_reset}{c_cyan}{c_bold}──{c_reset}")

def short_model(m):
    ml = m.lower()
    if "deepseek-v4-pro" in ml: return "dsv4pro"
    if "deepseek-v4-flash" in ml: return "dsv4fl"
    if "claude-opus-4" in ml: return "opus"
    if "claude-opus-5" in ml: return "opus5"
    if "claude-sonnet-5" in ml: return "sonnet5"
    if "glm-5.3" in ml: return "glm53"
    if "glm-5.2" in ml: return "glm52"
    if "kimi-k3" in ml: return "kimik3"
    if "gpt-5.6-luna-pro" in ml or "luna-pro" in ml: return "lunapro"
    if "gpt-5.6-luna" in ml or "luna" in ml: return "luna"
    if "gpt-5.6-sol" in ml or "sol" in ml: return "sol"
    if "gpt-5.6-terra" in ml or "terra" in ml: return "terra"
    if "gemini-3.7" in ml: return "gem37"
    return m.split("/")[-1] if "/" in m else m

# 1. Lemonade
lem_raw = sys.argv[1] if len(sys.argv) > 1 else ""
if not lem_raw:
    banner("Lemonade", "offline")
    print(f"  {c_dim}status{c_reset}   unreachable on :13305")
else:
    try:
        d = json.loads(lem_raw)
        status = d.get("status", "ok")
        ver = d.get("version", "")
        banner("Lemonade", f"{status} · v{ver}" if ver else status)
        loaded = d.get("all_models_loaded") or []
        if not loaded:
            print(f"  {c_dim}models{c_reset}   none (RAM clear)")
        else:
            print(f"  {c_dim}models{c_reset}")
            for m in loaded:
                pin = f"  {c_dim}pinned{c_reset}" if m.get("pinned") else ""
                m_type = m.get("type", "?")
                m_name = m.get("model_name", "?")
                m_dev = m.get("device", "?")
                m_stat = m.get("status", "?")
                print(f"    {m_type:<8} {m_name:<34} {m_dev} · {m_stat}{pin}")
        mm = d.get("max_models") or {}
        counts = {}
        for m in loaded:
            t = m.get("type", "?")
            counts[t] = counts.get(t, 0) + 1
        print(f"  {c_dim}slots{c_reset}    " + " · ".join(f"{k} {counts.get(k, 0)}/{v}" for k, v in mm.items()))
    except Exception:
        banner("Lemonade", "error")
        print(f"  {c_dim}status{c_reset}   invalid response")

print()

# 2. cptr / Open WebUI
banner("cptr / Open WebUI", ":13309")
cptr_model_path = sys.argv[2] if len(sys.argv) > 2 else ""
cptr_settings_path = sys.argv[3] if len(sys.argv) > 3 else ""

cptr_model = "(not configured)"
if os.path.exists(cptr_model_path):
    try:
        with open(cptr_model_path, encoding="utf-8") as f:
            raw = f.read().strip()
            if raw.startswith("agent:pi/"): raw = raw[len("agent:pi/"):]
            if raw: cptr_model = raw
    except Exception:
        pass

cptr_thinking = "max"
if os.path.exists(cptr_settings_path):
    try:
        with open(cptr_settings_path, encoding="utf-8") as f:
            data = json.load(f)
            val = data.get("defaultThinkingLevel")
            if val: cptr_thinking = val
    except Exception:
        pass

print(f"  {c_dim}target{c_reset}   {cptr_model}")
print(f"  {c_dim}thinking{c_reset} {c_yellow}{cptr_thinking}{c_reset}")

print()

# 3. Ramalama
banner("Ramalama", ":8081-:8084")
coder = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] else ""
embedder = sys.argv[5] if len(sys.argv) > 5 and sys.argv[5] else ""
reranker = sys.argv[6] if len(sys.argv) > 6 and sys.argv[6] else ""
vlm = sys.argv[7] if len(sys.argv) > 7 and sys.argv[7] else ""

def rama_fmt(val, port):
    if val:
        short_val = val.split("/")[-1]
        return f"{c_green}active{c_reset}   :{port}  {short_val}"
    return f"{c_dim}off{c_reset}      :{port}"

print(f"  {c_dim}coder{c_reset}         {rama_fmt(coder, 8081)}")
print(f"  {c_dim}embedder{c_reset}      {rama_fmt(embedder, 8082)}")
print(f"  {c_dim}reranker{c_reset}      {rama_fmt(reranker, 8083)}")
print(f"  {c_dim}vlm{c_reset}           {rama_fmt(vlm, 8084)}")

print()

# 4. Active Pi Sessions
state_dir = os.path.expanduser("~/.pi/running")
sessions = []
if os.path.exists(state_dir):
    for fpath in glob.glob(os.path.join(state_dir, "*.state")):
        base = os.path.basename(fpath)
        pid_str = os.path.splitext(base)[0]
        try:
            pid = int(pid_str)
            os.kill(pid, 0)
        except (ValueError, OSError):
            try: os.unlink(fpath)
            except OSError: pass
            continue

        meta = {}
        try:
            with open(fpath, encoding="utf-8") as sf:
                for line in sf:
                    line = line.strip()
                    if "=" in line:
                        k, v = line.split("=", 1)
                        meta[k.strip()] = v.strip()
        except Exception:
            continue

        sessions.append({
            "pid": pid_str,
            "type": meta.get("type", "pi"),
            "model": meta.get("model", "?"),
            "thinking": meta.get("thinking", "max"),
            "cwd": meta.get("cwd", ""),
            "sandbox": meta.get("sandbox", "")
        })

if not sessions:
    banner("Active Pi Sessions", "idle")
    print(f"  {c_dim}none{c_reset}")
else:
    count_str = f"{len(sessions)} running" if len(sessions) > 1 else "1 running"
    banner("Active Pi Sessions", count_str)
    for s in sorted(sessions, key=lambda x: int(x["pid"])):
        pid_display = f"[{s['pid']}]"
        agent_type = s['type']
        m_short = short_model(s['model'])
        thinking_str = f"thinking: {s['thinking']}"
        ctx_info = ""
        if s['cwd']:
            cwd_disp = f"~/{s['cwd']}" if not s['cwd'].startswith("~") else s['cwd']
            if s['sandbox'] and s['sandbox'] != "none":
                ctx_info = f"  {c_dim}·{c_reset} {cwd_disp} ({s['sandbox']})"
            else:
                ctx_info = f"  {c_dim}·{c_reset} {cwd_disp}"
        elif s['sandbox'] and s['sandbox'] != "none":
            ctx_info = f"  {c_dim}·{c_reset} ({s['sandbox']})"
        print(f"  {c_dim}{pid_display:<9}{c_reset} {c_bold}{agent_type:<8}{c_reset} {m_short:<12} {c_yellow}{thinking_str:<15}{c_reset}{ctx_info}")
PY
}

# lem-unload: drop ALL models from RAM and force-kill lingering engine processes
lem-unload() {
  local out
  out=$(curl -s -m 10 -X POST "$LEM_API/unload" -H 'Content-Type: application/json' -d '{}' 2>/dev/null) \
    || { echo "Lemonade not reachable on $LEM_API"; }
  if [[ -n "$out" ]]; then
    print -r -- "$out" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("message", "(no response)"))' 2>/dev/null \
      || print -r -- "$out"
  fi
  # Hardened: kill lemonade's engine inside its own container only.
  # DO NOT pkill llama-server host-wide: ramalama support models (embedder :8082,
  # reranker :8083, vlm :8084) also run llama-server inside their containers, and
  # a host-wide pkill nukes them (2026-08-15: lem-unload killed all three; the
  # embedder/reranker containers self-removed via --rm).
  podman exec lemonade pkill -9 llama-server 2>/dev/null || true
  echo "RAM cleared & orphan engine processes terminated."
}

