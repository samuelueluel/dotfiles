    && echo "▶ serving embedder (parallel 1, FA on) at http://localhost:8082/v1"
}
alias stop-embedder="ramalama stop embedder"

# Cross-encoder reranker for zotero semantic search (bge-reranker-v2-m3, Q8_0).
# llama-server --reranking exposes the OpenAI-compatible /v1/rerank endpoint; the
# zotero-mcp HTTP reranker patch calls it (semantic_search.reranker.url in
# ~/.config/zotero-mcp/config.json). Query-time only — no interaction with the
# embedder or Lemonade. -ub 8192 -b 8192 is the PHYSICAL batch size matching
# --ctx-size 8192: query+doc pairs up to full context (large tables / MinerU chunks)
# without 500 "increase the physical batch size". Served id: gpustack/bge-reranker-v2-m3-GGUF
RERANK_MODEL="hf://gpustack/bge-reranker-v2-m3-GGUF:Q8_0"
