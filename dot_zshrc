# Keep the historical helper name for pi/beta callers while sharing the
# exact same loader with pi-cptr-model.
_lem_preload() {
  command lem-load-model "$@"
}

pi() {
  export PI_SUBAGENTS_MAX_CONCURRENT=1
  _pi_nonstata_skills
  _pi_theme_args

  local model_id
  model_id=$(_pi_pick_local_model) || return 1
  _lem_preload "$model_id" || return 1
  local model_flag="local/$model_id"

  local go
  go=$(gum choose --header "pi · run in container?" \
    "no   unsandboxed" \
    "yes  sandboxed") || return 1

  local _state_dir="$HOME/.pi/running"
  mkdir -p "$_state_dir"
  local _state_file="$_state_dir/$$.state"
  export PI_STATE_FILE="$_state_file"

  case "${go%%[ ]*}" in
    no)
      printf 'type=pi\nmodel=%s\nthinking=max\ncwd=%s\nsandbox=unsandboxed\n' "$model_flag" "${PWD##*/}" > "$_state_file"
      printf '\033]2;π - %s\007' "${PWD##*/}"
      { command pi --tui-mode fullscreen "${_PI_SKILL_ARGS[@]}" "${_PI_THEME_ARGS[@]}" --model "$model_flag" "$@" } \
        always { rm -f "$_state_file"; unset PI_STATE_FILE; printf '\a' > /dev/tty }
      ;;
    yes)
      local target="${1:-$PWD}" abs_target is_file=0
      abs_target="$(realpath "$target" 2>/dev/null)" || { echo "Error: cannot resolve '$target'"; return 1; }
      [[ -f "$abs_target" ]] && is_file=1

      local level
      level=$(gum choose --header "pi · isolation level" \
        "1   write to dir  +  read all of \$HOME" \
        "2   write to dir  +  no read elsewhere" \
        "3   write to single file only") || return 1
      level="${level%%[ ]*}"

      if [[ "$level" == "3" ]] && (( !is_file )); then
        echo "Error: level 3 requires a file path, not a directory."; return 1
      fi

      printf 'type=pi\nmodel=%s\nthinking=max\ncwd=%s\nsandbox=sandboxed %s\n' "$model_flag" "${abs_target##*/}" "$level" > "$_state_file"
      printf '\033]2;π - %s\007' "${abs_target##*/}"
      { pi-safe-${level} "${abs_target}" --tui-mode fullscreen "${_PI_SKILL_ARGS[@]}" "${_PI_THEME_ARGS[@]}" --model "$model_flag" "${@:2}" } \
        always { rm -f "$_state_file"; unset PI_STATE_FILE; printf '\a' > /dev/tty }
      ;;
  esac
}

