# ============================================================
# AGENT LAUNCH COMMANDS
# ============================================================
# pi      = local model, Stata skills/binary excluded, optional sandboxing
# pihat   = cloud model, Stata skills/binary excluded, optional sandboxing
# beta    = local model, Stata skills + MCP + binary,  always sandboxed
# betahat = cloud model, Stata skills + MCP + binary,  always sandboxed
#
# "Stata skills/binary excluded": no Stata skill files loaded, MCP will not start,
#   Stata binary never mounted. Use for general coding tasks.
# "Stata skills + MCP + binary": all Stata skills and MCP config loaded;
#   /usr/local/stata19 mounted so the agent can actually run do-files.
#
# pihat / betahat write a state file to ~/.pi/running/ for status monitoring.

# Helper: populate global _PI_SKILL_ARGS with --no-skills + --skill for all skills except stata*.
# Also skips agy-only skills (auto, mode, manual) so they never load into pi.
_pi_nonstata_skills() {
  typeset -ga _PI_SKILL_ARGS
  _PI_SKILL_ARGS=("--no-skills")
  local -a _pi_skip=(auto mode manual)
  local s
  for s in ~/.agents/skills/*; do
    [[ -d "$s" ]] || continue
    [[ "${s:t}" == stata* ]] && continue
    (( ${_pi_skip[(Ie)${s:t}]} )) && continue
    _PI_SKILL_ARGS+=("--skill" "$s")
  done
  for s in ~/.pi/agent/skills/*(N); do
    [[ -d "$s" ]] || continue
    (( ${_pi_skip[(Ie)${s:t}]} )) && continue
    _PI_SKILL_ARGS+=("--skill" "$s")
  done
}

# --- LEMONADE HELPERS ---
LEM_API="http://127.0.0.1:13305/api/v1"

# lem-status: show all loaded models across every slot category, not just the LLM
lem-status() {
  local out
  out=$(curl -s -m 5 "$LEM_API/health" 2>/dev/null) || { echo "Lemonade not reachable on $LEM_API"; return 1; }
  [[ -z "$out" ]] && { echo "Lemonade not reachable on $LEM_API"; return 1; }
  print -r -- "$out" | python3 -c '
import sys, json
d = json.load(sys.stdin)
loaded = d.get("all_models_loaded") or []
print("server: %s  (v%s)" % (d.get("status", "?"), d.get("version", "?")))
if not loaded:
    print("loaded: none (RAM clear)")
else:
    print("loaded models:")
    for m in loaded:
        pin = " [pinned]" if m.get("pinned") else ""
        print("  - %-11s %s  (%s, %s)%s" % (
            m.get("type", "?"), m.get("model_name", "?"),
            m.get("device", "?"), m.get("status", "?"), pin))
mm = d.get("max_models") or {}
counts = {}
for m in loaded:
    counts[m.get("type", "?")] = counts.get(m.get("type", "?"), 0) + 1
print("slots (loaded/max): " + "  ".join(
    "%s=%d/%s" % (k, counts.get(k, 0), v) for k, v in mm.items()))
'
  # Ramalama embedder status (port 8082)
  local _embedder_id
  _embedder_id=$(curl -sf -m 2 "http://localhost:8082/v1/models" 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  if [[ -n "$_embedder_id" ]]; then
    printf '  %-10s  %-8s  active on :8082 (%s)\n' "embedder" "ramalama" "${_embedder_id##*/}"
  else
    printf '  %-10s  %-8s  off (:8082 inactive)\n' "embedder" "ramalama"
  fi

  # Ramalama reranker status (port 8083)
  local _reranker_id
  _reranker_id=$(curl -sf -m 2 "http://localhost:8083/v1/models" 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  if [[ -n "$_reranker_id" ]]; then
    printf '  %-10s  %-8s  active on :8083 (%s)\n' "reranker" "ramalama" "${_reranker_id##*/}"
  else
    printf '  %-10s  %-8s  off (:8083 inactive)\n' "reranker" "ramalama"
  fi

  # Ramalama VLM status (port 8084)
  local _vlm_id
  _vlm_id=$(curl -sf -m 2 "http://localhost:8084/v1/models" 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  if [[ -n "$_vlm_id" ]]; then
    printf '  %-10s  %-8s  active on :8084 (%s)\n' "vlm" "ramalama" "${_vlm_id##*/}"
  else
    printf '  %-10s  %-8s  off (:8084 inactive)\n' "vlm" "ramalama"
  fi

  # Cloud agents (pihat / betahat) — state files written at launch, removed on exit
  echo ""
  local _state_dir="$HOME/.pi/running"
  local _found_pi=0 _f _spid _type _m _t _short
  if [[ -d "$_state_dir" ]]; then
    for _f in "$_state_dir"/*.state(N); do
      _spid="${${_f:t}%.state}"
      kill -0 "$_spid" 2>/dev/null || { rm -f "$_f"; continue; }
      _type=$(grep '^type=' "$_f" | cut -d= -f2)
      _m=$(grep    '^model=' "$_f" | cut -d= -f2)
      _t=$(grep    '^thinking=' "$_f" | cut -d= -f2)
      case "$_m" in
        *deepseek-v4-pro)   _short="dsv4pro" ;;
        *deepseek-v4-flash) _short="dsv4fl"  ;;
        *claude-opus-4*)    _short="opus"    ;;
        *claude-opus-5*)    _short="opus5"   ;;
        *claude-sonnet-5)   _short="sonnet5" ;;
        *glm-5.2*)          _short="glm52"   ;;
        *kimi-k3*)          _short="kimik3"  ;;
        *gpt-5.6-luna-pro*|*luna-pro*) _short="lunapro" ;;
        *gemini-3.7*)        _short="gem37"   ;;
        *)                  _short="$_m"     ;;
      esac
      if [[ -n "$_t" ]]; then printf '  %-10s  %-8s  thinking: %s\n' "$_type" "$_short" "$_t"; else printf '  %-10s  %-8s\n' "$_type" "$_short"; fi
      _found_pi=1
    done
  fi
  (( _found_pi )) || printf '  cloud     —\n'
}

# lem-unload: drop ALL models from RAM and force-kill lingering engine processes
lem-unload() {
  local out
  out=$(curl -s -m 10 -X POST "$LEM_API/unload" -H 'Content-Type: application/json' -d '{}' 2>/dev/null) \
    || { echo "Lemonade not reachable on $LEM_API"; }
  if [[ -n "$out" ]]; then
    print -r -- "$out" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("message", "(no response)"))' 2>/dev/null \
      || print -r -- "$out"
  fi
  # Hardened: kill lemonade's engine inside its own container only.
  # DO NOT pkill llama-server host-wide: ramalama support models (embedder :8082,
  # reranker :8083, vlm :8084) also run llama-server inside their containers, and
  # a host-wide pkill nukes them (2026-08-15: lem-unload killed all three; the
  # embedder/reranker containers self-removed via --rm).
  podman exec lemonade pkill -9 llama-server 2>/dev/null || true
  echo "RAM cleared & orphan engine processes terminated."
}

