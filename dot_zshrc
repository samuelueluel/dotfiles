  ramalama serve -d -n reranker -p 8083 --image "$RAMA_IMG" --ctx-size 8192 --runtime-args="--reranking --parallel 1 -fa on -ub 8192 -b 8192 --no-mmap --direct-io" "$RERANK_MODEL" \
    && echo "▶ serving reranker (FA on, bge-reranker-v2-m3 Q8_0) at http://localhost:8083/v1/rerank"
}
