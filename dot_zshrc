# --- LLM CODING BENCHMARK ---
# Compare two local models on the same coding tasks: each model writes the code
# (loaded with Lemonade recipe defaults — no flag changes), then a frontier judge
# on OpenRouter scores it (1-10 + rubric). See ~/llm-bench/bench.py.
coder-bench() {
  local m1 m2
  m1=$(_pi_pick_local_model) || return 1
  m2=$(_pi_pick_local_model) || return 1
  python3 "$HOME/llm-bench/bench.py" --models "$m1,$m2" --tasks "$HOME/llm-bench/tasks.jsonl" --outdir "$HOME/llm-bench/out" "$@"
}

# --- AGY WRAPPER WITH MINIMAP NOTIFICATION ---
agy() {
  command agy "$@"
  local ret=$?
  # One ding path only: terminal BEL; niri-minimap supplies the visual badge.
  printf '\a'
  return $ret
}

# --- STATA TMUX HELPERS ---
# Function (not alias) so $PWD expands at call time, not shell startup:
# the new tmux session starts in the dir you launch from, so c(pwd) in
# Stata is the project root (used by project_globals.do for path macros).
stata-start() { tmux new-session -s stata -c "$PWD" '/usr/local/stata19/stata-mp'; }
alias stata-attach="tmux attach -t stata"
alias stata-kill="tmux kill-session -t stata 2>/dev/null && echo 'stata session killed' || echo 'no stata session running'"

# Launch Ghostty writing session with Monaspace Xenon (closes caller)
ghostty-write() {
  local log_dir="$HOME/.cache/ghostty"
  mkdir -p "$log_dir" || return 1
  (setsid -f env GHOSTTY_PROFILE=write ghostty \
    --gtk-single-instance=false \
    --config-default-files=false \
    --config-file="$HOME/.config/ghostty/config-write.ghostty" \
    "$@" </dev/null >>"$log_dir/launcher.log" 2>&1 &)
  exit
}

# Launch the regular Noctalia/New Mexico profile with the writing font (closes caller)
ghostty-write-nm() {
  local log_dir="$HOME/.cache/ghostty"
  mkdir -p "$log_dir" || return 1
  (setsid -f env GHOSTTY_PROFILE=write-nm ghostty \
    --gtk-single-instance=false \
    --config-default-files=false \
    --config-file="$HOME/.config/ghostty/config-write-nm.ghostty" \
    "$@" </dev/null >>"$log_dir/launcher.log" 2>&1 &)
  exit
}






