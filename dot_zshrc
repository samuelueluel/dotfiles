# _lem_preload <model_id>: pick MTP (Qwen/DeepSeek) + reasoning effort (Qwen3.8) + parallel,
# then load the model with those as a flag-level override merged over its saved recipe,
# so the agent connects to exactly the config chosen here.
_lem_preload() {
  local id="$1" args="" mtp effort par kv
  # real reachability check first, so a slow load is not mistaken for a dead server
  if ! curl -s -m 5 "$LEM_API/health" >/dev/null 2>&1; then
    print -r -- "Lemonade not reachable on $LEM_API (container up? try 'podman start lemonade')"
    return 1
  fi
  if [[ "$id" == Qwen3.8* ]]; then
    mtp=$(gum choose --header "speculative decoding" --selected "on" \
      "on       MTP (built-in draft, no extra model)" \
      "dflash2  block-diffusion drafter (needs draft GGUF, ~1.5x MTP)" \
      "off") || return 1
    case "${mtp%%[ ]*}" in
      dflash2) args+=" --spec-type draft-dflash --spec-draft-model $QWEN38_DFLASH2_DRAFT --spec-draft-n-max 4 -ctkd q8_0 -ctvd q8_0" ;;
      off) args+=" --spec-type none" ;;
    esac

    effort=$(gum choose --header "thinking / reasoning effort" \
      "xhigh   deep reasoning (default)" \
      "medium  balanced reasoning" \
      "low     fast / concise reasoning" \
      "off     instruct mode (no thinking)") || return 1
    # NB: JSON cannot travel inside llamacpp_args — Lemonade's arg tokenizer eats
    # the quotes (github.com/lemonade-sdk/lemonade issue #1939; still broken in
    # 10.8.0). Reasoning effort is baked into per-effort jinja variants instead:
    #   xhigh   = base template default (no override needed)
    #   medium/low/off = qwen3.8-froggeric-v22-{medium,low,off}.jinja
    # --chat-template-file (a plain path) survives tokenization and overrides the
    # recipe's template at load time.
    case "${effort%%[ ]*}" in
      xhigh)
        args+=" $QWEN38_SAMPLING"
        ;;
      medium)
        args+=" $QWEN38_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-medium.jinja"
        ;;
      low)
        args+=" $QWEN38_SAMPLING --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-low.jinja"
        ;;
      off)
        args+=" --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5 --chat-template-file /root/.cache/lemonade/qwen3.8-froggeric-v22-off.jinja"
        ;;
    esac

    kv=$(gum choose --header "KV cache quantization" --selected "f16" \
      "f16  default (unquantized f16)" \
      "q8   Q8 kv cache (saves RAM)") || return 1
    case "${kv%%[ ]*}" in
      q8)  args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
  elif [[ "$id" == Ling* ]]; then
    mtp=$(gum choose --header "speculative decoding" --selected "on" "on" "off") || return 1
    [[ "$mtp" == "off" ]] && args+=" --spec-type none"
    args+=" $LING3FLASH_SAMPLING"

    kv=$(gum choose --header "KV cache quantization" --selected "f16" \
      "f16  default (unquantized f16)" \
      "q8   Q8 kv cache (saves RAM)") || return 1
    case "${kv%%[ ]*}" in
      q8)  args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
  elif [[ "$id" == DeepSeek* ]]; then
    mtp=$(gum choose --header "speculative decoding" --selected "on" "on" "off") || return 1
    [[ "$mtp" == "off" ]] && args+=" --spec-type none"
    args+=" $DS4FLASH_SAMPLING"

    kv=$(gum choose --header "KV cache quantization" --selected "f16" \
      "f16  default (unquantized f16)" \
      "q8   Q8 kv cache (saves RAM)") || return 1
    case "${kv%%[ ]*}" in
      q8)  args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
  elif [[ "$id" == Qwen* ]]; then
    mtp=$(gum choose --header "speculative decoding" --selected "on" "on" "off") || return 1
    [[ "$mtp" == "off" ]] && args+=" --spec-type none"
    args+=" $QWEN_SAMPLING"

    kv=$(gum choose --header "KV cache quantization" --selected "f16" \
      "f16  default (unquantized f16)" \
      "q8   Q8 kv cache (saves RAM)") || return 1
    case "${kv%%[ ]*}" in
      q8)  args+=" -ctk q8_0 -ctv q8_0" ;;
      f16) args+=" -ctk f16 -ctv f16" ;;
    esac
  fi
  par=$(gum choose --header "parallel slots" --selected "1" "1" "2") || return 1
  args+=" --parallel $par"
  args="${args# }"

  # if the weights are not downloaded yet, the load also pulls them (can be tens of GB)
  local note="loading ${id}  [override: ${args}]"
  curl -s -m 10 "$LEM_API/models" 2>/dev/null | grep -q "\"$id\"" \
    || note="first load of ${id}: downloading weights (several minutes) then loading  [override: ${args}]"

  local load_json resp
  load_json=$(python3 -c 'import sys, json; print(json.dumps({"model_name": sys.argv[1], "llamacpp_args": sys.argv[2]}))' "$id" "$args")

  resp=$(gum spin --show-output --title "$note" -- \
    curl -s -m 3600 -X POST "$LEM_API/load" -H 'Content-Type: application/json' \
    -d "$load_json")
  print -r -- "$resp" | grep -q '"status":"success"' && return 0
  print -r -- "load failed: ${resp:-timed out; check 'podman logs lemonade' or 'lem-status'}"
  return 1
}

pi() {
  export PI_SUBAGENTS_MAX_CONCURRENT=1
  _pi_nonstata_skills

  local model_id
  model_id=$(_pi_pick_local_model) || return 1
  _lem_preload "$model_id" || return 1
  local model_flag="local/$model_id"

  local go
  go=$(gum choose --header "pi · run in container?" \
    "no   unsandboxed" \
    "yes  sandboxed") || return 1

  case "${go%%[ ]*}" in
    no)
      printf '\033]2;π - %s\007' "${PWD##*/}"
      command pi "${_PI_SKILL_ARGS[@]}" --model "$model_flag" "$@"
      printf '\a'
      ;;
    yes)
      local target="${1:-$PWD}" abs_target is_file=0
      abs_target="$(realpath "$target" 2>/dev/null)" || { echo "Error: cannot resolve '$target'"; return 1; }
      [[ -f "$abs_target" ]] && is_file=1

      local level
      level=$(gum choose --header "pi · isolation level" \
        "1   write to dir  +  read all of \$HOME" \
        "2   write to dir  +  no read elsewhere" \
        "3   write to single file only") || return 1
      level="${level%%[ ]*}"

      if [[ "$level" == "3" ]] && (( !is_file )); then
        echo "Error: level 3 requires a file path, not a directory."; return 1
      fi

      printf '\033]2;π - %s\007' "${abs_target##*/}"
      pi-safe-${level} "${abs_target}" "${_PI_SKILL_ARGS[@]}" --model "$model_flag" "${@:2}"
      printf '\a'
      ;;
  esac
}

pihat() {
  export PI_SUBAGENTS_MAX_CONCURRENT=4
  _pi_nonstata_skills

  # Routing baked into models.json: openrouter-ds (CN key) = DeepSeek only,
  # openrouter-us (US key) = everything else. Model + thinking level via /model
  # and Shift+Tab; per-model sampling via samplingParams.
  local model_flag="${PIHAT_MODEL:-openrouter-ds/deepseek/deepseek-v4-flash-0731}"
  # Scope /model to curated cloud providers (local hidden by default; Tab toggles all/scoped)
  local model_scope="openrouter-us/**:max,openrouter-ds/**:max,openai-codex/**:max"

  local go
  go=$(gum choose --header "pihat · run in container?" \
    "no   unsandboxed" \
    "yes  sandboxed") || return 1

  local _state_dir="$HOME/.pi/running"
  mkdir -p "$_state_dir"
  local _state_file="$_state_dir/$$.state"
  printf 'type=pihat\nmodel=%s\n' "$model_flag" > "$_state_file"

  case "${go%%[ ]*}" in
    no)
      printf '\033]2;π̂ - %s\007' "${PWD##*/}"
      { command pi "${_PI_SKILL_ARGS[@]}" --model "$model_flag" --models "$model_scope" "$@" } \
        always { rm -f "$_state_file"; printf '\a' > /dev/tty }
      ;;
    yes)
      local target="${1:-$PWD}" abs_target is_file=0
      abs_target="$(realpath "$target" 2>/dev/null)" || { echo "Error: cannot resolve '$target'"; return 1; }
      [[ -f "$abs_target" ]] && is_file=1

      local level
      level=$(gum choose --header "pihat · isolation level" \
        "1   write to dir  +  read all of \$HOME" \
        "2   write to dir  +  no read elsewhere" \
        "3   write to single file only") || return 1
      level="${level%%[ ]*}"

      if [[ "$level" == "3" ]] && (( !is_file )); then
        echo "Error: level 3 requires a file path, not a directory."; return 1
      fi

      printf '\033]2;π̂ - %s\007' "${abs_target##*/}"
      { pi-safe-${level} "${abs_target}" "${_PI_SKILL_ARGS[@]}" --model "$model_flag" --models "$model_scope" "${@:2}" } \
        always { rm -f "$_state_file"; printf '\a' > /dev/tty }
      ;;
  esac
}

beta() {
  export PI_SUBAGENTS_MAX_CONCURRENT=1
  local target="${1:-$PWD}" abs_target
  abs_target="$(realpath "$target" 2>/dev/null)" || { echo "Error: cannot resolve '$target'"; return 1; }
  [[ -d "$abs_target" ]] || { echo "Error: '$target' is not a directory."; return 1; }

  local model_id
  model_id=$(_pi_pick_local_model) || return 1
  _lem_preload "$model_id" || return 1
  local model_flag="local/$model_id"

  local level
  level=$(gum choose --header "beta · isolation level" \
    "1   write to dir  +  read all of \$HOME  +  Stata binary mounted" \
    "2   write to dir  +  no read elsewhere   +  Stata binary mounted") || return 1
  level="${level%%[ ]*}"

  printf '\033]2;β - %s\007' "${abs_target##*/}"
  pi-safe-stata-${level} "${abs_target}" --model "$model_flag" --append-system-prompt "$HOME/.pi/agent/APPEND_SYSTEM_BETA.md" "${@:2}"
  printf '\a' > /dev/tty
}

betahat() {
  export PI_SUBAGENTS_MAX_CONCURRENT=4

  # Routing baked into models.json: openrouter-ds (CN key) = DeepSeek only,
  # openrouter-us (US key) = everything else. Model + thinking level via /model
  # and Shift+Tab; per-model sampling via samplingParams.
  local model_flag="${BETAHAT_MODEL:-openrouter-ds/deepseek/deepseek-v4-flash-0731}"
  # Scope /model to curated cloud providers (local hidden by default; Tab toggles all/scoped)
  local model_scope="openrouter-us/**:max,openrouter-ds/**:max,openai-codex/**:max"

  local target="${1:-$PWD}" abs_target
  abs_target="$(realpath "$target" 2>/dev/null)" || { echo "Error: cannot resolve '$target'"; return 1; }
  [[ -d "$abs_target" ]] || { echo "Error: '$target' is not a directory."; return 1; }

  local level
  level=$(gum choose --header "betahat · isolation level" \
    "1   write to dir  +  read all of \$HOME  +  Stata binary mounted" \
    "2   write to dir  +  no read elsewhere   +  Stata binary mounted") || return 1
  level="${level%%[ ]*}"

  local _state_dir="$HOME/.pi/running"
  mkdir -p "$_state_dir"
  local _state_file="$_state_dir/$$.state"
  printf 'type=betahat\nmodel=%s\n' "$model_flag" > "$_state_file"
  printf '\033]2;β̂ - %s\007' "${abs_target##*/}"
  { pi-safe-stata-${level} "${abs_target}" --model "$model_flag" --models "$model_scope" --append-system-prompt "$HOME/.pi/agent/APPEND_SYSTEM_BETA.md" "${@:2}" } \
    always { rm -f "$_state_file"; printf '\a' > /dev/tty }
}

# --- LLM CODING BENCHMARK ---
# Compare two local models on the same coding tasks: each model writes the code
# (loaded with Lemonade recipe defaults — no flag changes), then a frontier judge
# on OpenRouter scores it (1-10 + rubric). See ~/llm-bench/bench.py.
coder-bench() {
  local m1 m2
  m1=$(_pi_pick_local_model) || return 1
  m2=$(_pi_pick_local_model) || return 1
  python3 "$HOME/llm-bench/bench.py" --models "$m1,$m2" --tasks "$HOME/llm-bench/tasks.jsonl" --outdir "$HOME/llm-bench/out" "$@"
}

# --- AGY WRAPPER WITH MINIMAP NOTIFICATION ---
agy() {
  command agy "$@"
  local ret=$?
  # One ding path only: terminal BEL; niri-minimap supplies the visual badge.
  printf '\a'
  return $ret
}

# --- STATA TMUX HELPERS ---
# Function (not alias) so $PWD expands at call time, not shell startup:
# the new tmux session starts in the dir you launch from, so c(pwd) in
# Stata is the project root (used by project_globals.do for path macros).
stata-start() { tmux new-session -s stata -c "$PWD" '/usr/local/stata19/stata-mp'; }
alias stata-attach="tmux attach -t stata"
alias stata-kill="tmux kill-session -t stata 2>/dev/null && echo 'stata session killed' || echo 'no stata session running'"



