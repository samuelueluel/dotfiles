pi-safe-1() {
  local target_dir="${1:-$PWD}"
  local abs_dir="$(realpath "$target_dir")"

  if [[ "$abs_dir" == "$HOME" ]]; then
    echo "Error: Cannot run pi-safe-1 with write access to your entire home directory."
    return 1
  fi

  echo -e "\033[33mWARNING: You are giving Pi WRITE access to directory: $abs_dir (including subdirectories)\033[0m"
  echo -e "\033[33mAnd READ access to everywhere else in: $HOME\033[0m"
  if read -q "choice?Do you want to proceed? [y/N] "; then
    echo
  else
    echo -e "\nAborted."
    return 1
  fi

  setopt localtraps
  local container_name="pi-safe-1-$$"
  trap 'podman rm -f -t0 "$container_name" >/dev/null 2>&1 &!' EXIT INT TERM HUP

  podman run --init -it --rm \
    --name "$container_name" \
    --network=host \
    --userns=keep-id \
    --security-opt label=disable \
    -e HOME="$HOME" \
    -e TERM=xterm-256color \
    -e COLORTERM \
    -e LANG \
    -e OPENROUTER_API_KEY_US \
    -e OPENROUTER_API_KEY_DS \
    -e PI_SUBAGENTS_MAX_CONCURRENT \
    -e PULSE_SERVER="unix:/run/user/1000/pulse/native" \
    ${PI_CODING_AGENT_DIR:+-e PI_CODING_AGENT_DIR="$PI_CODING_AGENT_DIR"} \
    -v "$HOME":"$HOME":ro \
    -v "$abs_dir":"$abs_dir" \
    -v "$HOME/.pi":"$HOME/.pi" \
    -v "$HOME/.agents":"$HOME/.agents":ro \
    -v "$HOME/.local/share/uv":"$HOME/.local/share/uv" \
    -v "$HOME/.cache/uv":"$HOME/.cache/uv" \
    ${XDG_RUNTIME_DIR:+-v} ${XDG_RUNTIME_DIR:+/run/user/1000/pulse/native:/run/user/1000/pulse/native} \
    -w "$abs_dir" \
    --entrypoint tmux \
    localhost/pi-safe:latest -u -f /etc/pi-tmux.conf new-session -A -s pi "pi $(printf '%q ' "${@:2}")"
}

