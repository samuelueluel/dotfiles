# ============================================================
# AGENT LAUNCH COMMANDS
# ============================================================
# pi      = local model, Stata skills/binary excluded, optional sandboxing
# pihat   = cloud model, Stata skills/binary excluded, optional sandboxing
# beta    = local model, Stata skills + MCP + binary,  always sandboxed
# betahat = cloud model, Stata skills + MCP + binary,  always sandboxed
#
# "Stata skills/binary excluded": no Stata skill files loaded, MCP will not start,
#   Stata binary never mounted. Use for general coding tasks.
# "Stata skills + MCP + binary": Stata skills and the beta MCP config loaded
#   (Last.fm excluded); /usr/local/stata19 mounted for do-file execution.
#
# pihat / betahat write a state file to ~/.pi/running/ for status monitoring.

# Helper: populate global _PI_SKILL_ARGS with --no-skills + --skill for all skills except stata*.
# Also skips agy-only skills (auto, mode, manual) so they never load into pi.
_pi_nonstata_skills() {
  typeset -ga _PI_SKILL_ARGS
  _PI_SKILL_ARGS=("--no-skills")
  local -a _pi_skip=(auto mode manual)
  local s
  for s in ~/.agents/skills/*; do
    [[ -d "$s" ]] || continue
    [[ "${s:t}" == stata* ]] && continue
    (( ${_pi_skip[(Ie)${s:t}]} )) && continue
    _PI_SKILL_ARGS+=("--skill" "$s")
  done
  for s in ~/.pi/agent/skills/*(N); do
    [[ -d "$s" ]] || continue
    (( ${_pi_skip[(Ie)${s:t}]} )) && continue
    _PI_SKILL_ARGS+=("--skill" "$s")
  done
}

# Helper: populate global _PI_STATA_SKILL_ARGS with --no-skills + --skill for Stata research skills.
# Skips agy-only skills (auto, mode, manual) and non-research skills (music).
_pi_stata_skills() {
  typeset -ga _PI_STATA_SKILL_ARGS
  _PI_STATA_SKILL_ARGS=("--no-skills")
  local -a _beta_skip=(auto mode manual music)
  local s
  for s in ~/.agents/skills/*; do
    [[ -d "$s" ]] || continue
    (( ${_beta_skip[(Ie)${s:t}]} )) && continue
    _PI_STATA_SKILL_ARGS+=("--skill" "$s")
  done
  for s in ~/.pi/agent/skills/*(N); do
    [[ -d "$s" ]] || continue
    (( ${_beta_skip[(Ie)${s:t}]} )) && continue
    _PI_STATA_SKILL_ARGS+=("--skill" "$s")
  done
}

# Helper: choose Pi theme for Ghostty profiles per-run.
_pi_theme_args() {
  typeset -ga _PI_THEME_ARGS
  case "$GHOSTTY_PROFILE" in
    write)
      _PI_THEME_ARGS=("--use-theme" "gruvbox-light-soft")
      ;;
    write-nm)
      _PI_THEME_ARGS=("--use-theme" "noctalia")
      ;;
    *)
      _PI_THEME_ARGS=()
      ;;
  esac
}

